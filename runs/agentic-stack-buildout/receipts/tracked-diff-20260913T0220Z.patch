+            result = certify_build(build, "julie_synthetic")
+        self.assertEqual(result["verdict"], "CHECKLIST_BLOCK")
+        self.assertIn("model_necessity_claims refused", result["binding_reason"])
+
+    def test_inventoried_model_ops_allow_the_claims(self):
+        build, _ = _build(self)  # one claim; julie_synthetic carries one MODEL op
+        result = certify_build(build, "julie_synthetic")
+        self.assertEqual(result["verdict"], "CHECKLIST_PASS")
+        check = next(x for x in result["checks"] if x["check"] == "model_claims_inventoried")
+        self.assertTrue(check["pass"])
