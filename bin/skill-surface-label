#!/usr/bin/env python3
"""skill-surface-label: real-traffic routing agreement sampled through hosted JEV only.

Router under test: `skill-surface route --json`. Redact secrets before hosted verification;
remaining private details defer. There is no local inference fallback.
Hosted verifier agreement is the same model family as the router, so new rows are
independent=false. Only preserved historical independent labels feed calibration.

  skill-surface-label build [--limit 200]    real chats -> _label-set.jsonl (stays on this machine)
  skill-surface-label build --append [--limit 50]  keep the set, add up to N newer real chats
  skill-surface-label run [--workers 3]      route + verify every unsampled item (resumable)
  skill-surface-label run --relabel          resample rows without independent historical labels
  skill-surface-label report [--write]       agreement, per-level calibration, _route-evals-real.json;
                                             --write stores calibrated thresholds in the manifest
"""
import concurrent.futures as cf
import datetime
import glob
import hashlib
import json
import os
import pwd
import re
import sqlite3
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader

HOME = os.environ.get("SKILL_SURFACE_HOME") or pwd.getpwuid(os.getuid()).pw_dir
ASIDE = f"{HOME}/.aside/u/0"
LIB = f"{ASIDE}/skill-library"
SESS = f"{ASIDE}/sessions"
SET = f"{LIB}/_label-set.jsonl"
OUT = f"{LIB}/_labels.jsonl"
EVAL = f"{LIB}/_route-evals-real.json"
SS = f"{HOME}/.rig/bin/skill-surface"
RIGCAP = f"{HOME}/Developer/rig-capabilities"
PROBE = re.compile(r"^\s*(ok\.?|hello|hi|hey|greeting|12|test)\s*$|reply (exactly|with)|connectivity|connection test|"
                   r"model test|repl connection|example\.com|no tools|do not (browse|use tools)|verification probe|"
                   r"use repl exactly once|do not use tool", re.I)
SK = re.compile(r"skills/(?:user|builtin(?:/site-specific)?)/([a-z0-9_.-]+)/SKILL\.md|skill-library/([a-z0-9_.-]+)/SKILL\.md")
ss = SourceFileLoader("ss", SS).load_module()


def lab(p):
    return None if p is None else ("good" if p >= 0.9 else "bad" if p <= 0.35 else "unsure")


def clean(text):
    t = re.sub(r"<system_message>.*?</system_message>", " ", text, flags=re.S)
    t = re.sub(r"<[^>]{1,40}>", " ", t)
    return re.sub(r"\s+", " ", t).strip()


def first_user(sid):
    for f in glob.glob(f"{SESS}/*_{sid}/messages.jsonl"):
        for line in open(f, errors="replace"):
            try:
                m = json.loads(line)
            except Exception:
                continue
            if m.get("role") == "user":
                c = m.get("content")
                if isinstance(c, list):
                    c = " ".join(p.get("text", "") for p in c if isinstance(p, dict))
                return clean(str(c or "")), f
    return "", None


def skills_used(f, names):
    used = set()
    if f:
        for line in open(f, errors="replace"):
            for a, b in SK.findall(line):
                used.add(a or b)
    return sorted(n for n in used if n in names)


def build(limit, append=False):
    c = sqlite3.connect(f"file:{ASIDE}/state.db?mode=ro", uri=True)
    rows = c.execute("select id, title, trigger, created_at from sessions where parent_id is null "
                     "order by created_at desc").fetchall()
    E = ss.load()["entries"]
    out, seen, skipped = [], set(), {"routine": 0, "probe": 0, "empty": 0, "duplicate": 0}
    kept = []
    if append and os.path.exists(SET):  # grow the set: keep every task already labeled, add up to `limit` new ones
        kept = [json.loads(line) for line in open(SET)]
        have = {r["id"] for r in kept}
        seen = {hashlib.sha256(r["text"][:300].lower().encode()).hexdigest() for r in kept}
        rows = [r for r in rows if r[0] not in have]
    for sid, title, trig, ts in rows:
        try:
            tj = json.loads(trig or "{}")
        except Exception:
            tj = {}
        if tj.get("type") != "user":
            skipped["routine"] += 1
            continue
        text, f = first_user(sid)
        if not text:
            skipped["empty"] += 1
            continue
        if PROBE.search(text[:200]) or PROBE.search(title or ""):
            skipped["probe"] += 1
            continue
        h = hashlib.sha256(text[:300].lower().encode()).hexdigest()
        if h in seen:
            skipped["duplicate"] += 1
            continue
        seen.add(h)
        out.append({"id": sid, "title": title, "text": text[:600], "created": ts, "skills_used": skills_used(f, set(E))})
        if len(out) >= limit:
            break
    new_n = len(out)
    out = kept + out
    with open(SET + ".tmp", "w") as fh:
        for r in out:
            fh.write(json.dumps(r) + "\n")
    os.replace(SET + ".tmp", SET)
    sens = sum(1 for r in out if ss.SENSITIVE.search(r["text"]))
    print(f"label set: {len(out)} real tasks ({new_n} new, {sens} require redaction or deferral) | skipped {skipped} -> {SET}")
    return 0


def route(text):
    p = subprocess.run([sys.executable, SS, "route", text, "--json"], capture_output=True, text=True, timeout=600,
                       env={**os.environ, "SKILL_SURFACE_SOURCE": "label"})
    try:
        return json.loads(p.stdout)
    except Exception:
        return {"status": "ERROR", "error": (p.stderr or p.stdout)[-300:], "levels": []}



STOP = f"{LIB}/_label-stop"


def label_one(item, t, prev=None):
    if os.path.exists(STOP):
        raise RuntimeError("stopped: remove skill-library/_label-stop to resume")
    text = item["text"] or item["title"]
    reuse = prev and prev.get("router") == "hosted-jev" and prev.get("levels") and all(
        L.get("lane") in ("jev", "lane-rule") for L in prev["levels"])
    r = ({"levels": prev["levels"], "sensitive": prev.get("sensitive"), "status": prev.get("route_status"),
          "load": prev.get("load")} if reuse else route(text))
    lv = {L["level"]: L for L in r.get("levels", []) if "choice" in L}
    meta = lv.get(1, {}).get("choice")
    skill = lv.get(2, {}).get("choice")
    if skill == meta:
        skill = None
    safe_text, sensitive, privacy_error = ss.redact_for_hosted(text)
    row = {"id": item["id"], "title": item["title"], "text_sha256": hashlib.sha256(text.encode()).hexdigest(),
           "sensitive": sensitive, "route_status": r.get("status"),
           "router": "hosted-jev" if any(L.get("lane") == "jev" for L in lv.values()) else "not_evaluated",
           "levels": [{k: L.get(k) for k in ("level", "kind", "choice", "confidence", "verdict", "decision_id", "lane")}
                      for L in r.get("levels", []) if "choice" in L],
           "load": r.get("load"), "skills_used": item.get("skills_used", []), "ts": datetime.datetime.now().isoformat()}
    meta_q = (f"The area '{meta}' ({t.info(meta)[1]}) is the right area of skills to handle this request"
              if meta in t.metas else None)
    skill_q = (f"The skill '{skill}' ({(t.E[skill].get('purpose') or '')[:220]}) is the right skill to handle this request"
               if skill and skill in t.E else None)
    row["independent"] = False
    try:
        if safe_text is None:
            row.update({"labeler": None, "deferred": privacy_error})
        elif not lv:
            row.update({"labeler": None, "deferred": "routing provided no classified candidate"})
        else:
            sys.path.insert(0, RIGCAP)
            from rig_capabilities import s1gate
            from rig_capabilities.s1gate import DecisionLog, Rubric, evaluate
            if s1gate.JEV_ENDPOINT != "https://api.typesafe.ai/v1/systemone":
                raise RuntimeError("labeler requires the hosted JEV API endpoint")
            qs = {"meta_choice": {"type": "choice", "instructions": "Which area of Mike's skills should handle this request",
                                  "criteria": {**{mm: t.info(mm)[1] for mm in t.metas}, "other": "None of these areas fits"}}}
            if meta_q:
                qs["meta_fit"] = {"type": "noul", "instructions": meta_q}
            if skill_q:
                qs["skill_fit"] = {"type": "noul", "instructions": skill_q}
            rb = Rubric(name="skill-surface.label", stage="label", lane="skill-surface",
                        description="Verify the routed meta and skill for one real task", questions=qs, rules=[])
            log = DecisionLog()
            try:
                res = evaluate(rb, f"Request from Mike: {safe_text}",
                               subject=f"skill-surface label sha256:{row['text_sha256']}",
                               log=log, model="jev-latest")
            finally:
                log.close()
            if res.error:
                raise RuntimeError(res.error)
            if not str(res.model or "").startswith("jev-"):
                raise RuntimeError("invalid hosted JEV label provenance")
            a = res.answers
            row.update({"labeler": "hosted-jev-verifier", "label_decision_id": res.decision_id,
                        "label_model": res.model, "label_endpoint": s1gate.JEV_ENDPOINT,
                        "meta_fit": (a.get("meta_fit") or {}).get("noul"),
                        "skill_fit": (a.get("skill_fit") or {}).get("noul"),
                        "meta_choice": (a.get("meta_choice") or {}).get("choice"),
                        "meta_choice_conf": (a.get("meta_choice") or {}).get("confidence")})
    except Exception as ex:
        row.update({"labeler": None, "label_error": f"{type(ex).__name__}: {ex}"[:200]})
    row["label_meta"] = lab(row.get("meta_fit"))
    row["label_skill"] = lab(row.get("skill_fit"))
    bm = sorted({t.E[s]["meta"] for s in row["skills_used"] if s in t.E})
    row["behavior_metas"] = bm
    row["behavior_agrees"] = (meta in bm) if (bm and meta) else None
    return row


def latest_rows():
    """Last row per task id wins, so a relabel pass supersedes earlier rows without rewriting the file."""
    rows = {}
    if os.path.exists(OUT):
        for line in open(OUT):
            try:
                r = json.loads(line)
                rows[r["id"]] = r
            except Exception:
                pass
    return rows


def run(workers, relabel=False):
    items = [json.loads(line) for line in open(SET)]
    last = latest_rows()
    if relabel:
        done = {k for k, r in last.items() if r.get("independent") and r.get("labeler")}
    else:
        done = set(last)
    todo = [i for i in items if i["id"] not in done]
    t = ss.Tree(ss.load())
    print(f"{now()} labeling {len(todo)} of {len(items)} (already done {len(done)}), workers={workers}", flush=True)
    failed = 0
    t0 = time.time()
    with cf.ThreadPoolExecutor(max_workers=workers) as ex, open(OUT, "a") as fh:
        futs = {ex.submit(label_one, i, t, last.get(i["id"]) if relabel else None): i for i in todo}
        for n, fu in enumerate(cf.as_completed(futs), 1):
            try:
                row = fu.result()
            except Exception as e:
                row = {"id": futs[fu]["id"], "error": f"{type(e).__name__}: {e}"[:200]}
            fh.write(json.dumps(row) + "\n")
            fh.flush()
            failed += bool(row.get("deferred") or row.get("label_error") or row.get("error"))
            lv = {L["level"]: L for L in row.get("levels", [])}
            print(f"{now()} [{n}/{len(todo)}] {row.get('router', '?'):<13} {str(lv.get(1, {}).get('choice')):<30} "
                  f"meta={row.get('label_meta')} skill={row.get('label_skill')} labeler={row.get('labeler')} "
                  f"({int(time.time() - t0)}s)", flush=True)
    print(f"{now()} sampling complete; {failed} deferred or failed", flush=True)
    return 2 if failed else 0


def now():
    return datetime.datetime.now().strftime("%H:%M:%S")


def calib(pairs, floor=0.95, min_pass=20):
    """pairs: [(router_confidence, good_bool)]. Lowest threshold whose PASS set keeps precision >= floor."""
    best = None
    for thr in [x / 100 for x in range(50, 99, 1)]:
        passed = [g for c, g in pairs if c is not None and c > thr]
        if len(passed) < min_pass:
            continue
        prec = sum(passed) / len(passed)
        rec = sum(passed) / max(1, sum(g for _, g in pairs))
        if prec >= floor:
            best = {"threshold": thr, "precision": round(prec, 3), "recall": round(rec, 3), "n_pass": len(passed)}
            break
    return best


def report(write):
    rows = list(latest_rows().values())
    t = ss.Tree(ss.load())
    ok = [r for r in rows if r.get("labeler")]
    print(f"rows {len(rows)} | labeled {len(ok)} | label errors {sum(1 for r in rows if r.get('label_error') or r.get('error'))}")
    out = {}
    for router in ("hosted-jev", "openjev-local"):
        rr = [r for r in ok if r.get("router") == router]
        if not rr:
            continue
        lm = [r["label_meta"] for r in rr]
        ls = [r["label_skill"] for r in rr if r.get("label_skill")]
        agree = [r for r in rr if r.get("meta_choice_conf") and r["meta_choice_conf"] >= 0.9]
        agree_n = sum(1 for r in agree if r["levels"] and r["levels"][0]["choice"] == r["meta_choice"])
        beh = [r for r in rr if r.get("behavior_agrees") is not None]
        retired = " (retired historical route)" if router != "hosted-jev" else ""
        print(f"\n== router {router}{retired}: {len(rr)} tasks, labeled by {sorted({str(r['labeler']) for r in rr})} "
              f"(independent: {sum(1 for r in rr if r.get('independent'))})")
        print(f"   meta labels  good {lm.count('good')}  bad {lm.count('bad')}  unsure {lm.count('unsure')}  none {lm.count(None)}")
        print(f"   skill labels good {ls.count('good')}  bad {ls.count('bad')}  unsure {ls.count('unsure')}")
        if agree:
            print(f"   labeler's own pick agrees with router meta: {agree_n}/{len(agree)} = {agree_n / len(agree):.0%}")
        if beh:
            print(f"   router meta matches a meta whose skill was actually read in that chat: "
                  f"{sum(1 for r in beh if r['behavior_agrees'])}/{len(beh)}")
        cal = {}
        for level, key in ((1, "label_meta"), (2, "label_skill")):
            pairs = [(next((L["confidence"] for L in r["levels"] if L["level"] == level), None), r[key] == "good")
                     for r in rr if r.get(key) in ("good", "bad") and r.get("independent")]
            c = calib(pairs)
            cal[level] = {"n_labeled": len(pairs), **(c or {"threshold": None})}
            print(f"   L{level} calibration from {len(pairs)} independent good/bad labels: {c or 'not enough independent labels yet (need precision >= 0.95 over 20+ passes); threshold stays 0.90'}")
        out[router] = cal
    ev = []
    for r in ok:
        if not r.get("independent"):
            continue
        meta = r["levels"][0]["choice"] if r.get("levels") else None
        if not meta:
            continue
        if r["label_meta"] == "good":
            exp = [meta]
        elif r["label_meta"] == "bad" and r.get("meta_choice_conf") and r["meta_choice_conf"] >= 0.9 and r["meta_choice"] not in (meta, "other"):
            exp = [r["meta_choice"]]
        else:
            continue
        sk = next((L["choice"] for L in r["levels"] if L["level"] == 2), None)
        text = next((json.loads(line)["text"] for line in open(SET) if json.loads(line)["id"] == r["id"]), None)
        if not text:
            continue
        ev.append({"task": text, "meta": exp, "skill": [sk] if (r.get("label_skill") == "good" and sk) else [],
                   "sensitive": r.get("sensitive", False), "label_source": r.get("labeler")})
    with open(EVAL, "w") as fh:
        json.dump(ev, fh, indent=1)
    print(f"\nreal-traffic eval written: {len(ev)} tasks -> {EVAL}")
    if write:
        m = ss.load()
        m["route_calibration"] = {"labeled_by": "preserved independent historical labels only; hosted verifier agreement excluded",
                                  "at": datetime.datetime.now().isoformat(), "by_router": out}
        ss.save(m)
        print("calibration stored in manifest (route uses a level's threshold only when it has one)")
    return 0


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if a[0] == "build":
        return build(int(a[a.index("--limit") + 1]) if "--limit" in a else 200, append="--append" in a)
    if a[0] == "run":
        return run(int(a[a.index("--workers") + 1]) if "--workers" in a else 3, relabel="--relabel" in a)
    if a[0] == "report":
        return report("--write" in a)
    print(__doc__)
    return 3


if __name__ == "__main__":
    sys.exit(main())
