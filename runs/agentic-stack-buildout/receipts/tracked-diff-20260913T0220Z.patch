+class StandardUnavailableTests(unittest.TestCase):
+    """v4: the owner table lives ONLY in the authority standard. A missing or
+    contract-mismatched standard must refuse selection, not fall back to a
+    code-resident table."""
+
+    def tearDown(self):
+        import tool_selection as ts
+        ts._STANDARD_CACHE = None
+
+    def test_missing_standard_blocks_selection_fail_closed(self):
+        import tool_selection as ts
+        ts._STANDARD_CACHE = None
+        with patch.object(ts, "STANDARD_FILE", Path("/nonexistent/tool-selection.v2.json")):
+            with self.assertRaises(ToolSelectionBlock) as caught:
+                select_framework({"ordinary_schedule": SCHEDULE})
+        self.assertEqual(caught.exception.code, "TOOL_STANDARD_UNAVAILABLE")
+
+    def test_contract_mismatched_standard_blocks(self):
+        import tool_selection as ts
+        good = json.loads((SKILL_ROOT / "authority/standards/tool_selection.v2.json").read_text())
+        good["selection_contract"] = "rig.d85.tool-selection.v9"
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        bad = Path(tmp, "tool_selection.v2.json")
+        bad.write_text(json.dumps(good), encoding="utf-8")
+        ts._STANDARD_CACHE = None
+        with patch.object(ts, "STANDARD_FILE", bad):
+            with self.assertRaises(ToolSelectionBlock) as caught:
+                select_framework({"ordinary_schedule": SCHEDULE})
+        self.assertEqual(caught.exception.code, "TOOL_STANDARD_UNAVAILABLE")
+        self.assertIn("v9", caught.exception.detail)
+
+
+class ModelOpInventoryTests(unittest.TestCase):
+    """A12: certification refuses MODEL necessity claims the source-inventoried
+    classification does not carry."""
+
