+def verify_serial(path: Path, ttl_seconds: int = 86400, *, now: int | None = None) -> dict[str, Any]:
+    """Verify one issued receipt: signature, schema, expiry window, and the
+    marker state it recorded. Statuses are closed: ok, marker_moved,
+    marker_changed, signature_mismatch, schema_mismatch, expiry_breached,
+    receipt_not_found."""
+    path = Path(path)
+    receipts_dir = path.parent
+    gate_root = receipts_dir.parent
+    current_time = int(time.time() if now is None else now)
+    base: dict[str, Any] = {"receipt": str(path), "ttl_seconds": ttl_seconds}
+    try:
+        raw = path.read_bytes()
+    except OSError:
+        return {**base, "status": "receipt_not_found"}
+    try:
+        record = json.loads(raw, object_pairs_hook=d85._closed_json_object)
+    except (json.JSONDecodeError, AdmissionBlock):
+        return {**base, "status": "schema_mismatch", "reason": "closed-object parse failed"}
+    if not isinstance(record, dict) or record.get("schema") != RECEIPT_SCHEMA:
+        return {**base, "status": "schema_mismatch", "reason": "schema"}
+    if set(record) != RECEIPT_KEYS | {"receipt_sha256", "signature"}:
+        return {**base, "status": "schema_mismatch", "reason": "key set"}
+    import re as _re
+
+    hex64 = _re.compile(r"[0-9a-f]{64}")
+    shape_errors: list[str] = []
+    for field in ("process_id", "run_id", "action_sha256", "approver", "marker_name", "marker_sha256"):
+        if not isinstance(record.get(field), str) or not record.get(field):
+            shape_errors.append(field)
+    if isinstance(record.get("run_id"), str) and not (
+        record["run_id"].startswith("sha256:") and hex64.fullmatch(record["run_id"][7:])
+    ):
+        shape_errors.append("run_id")
+    if isinstance(record.get("action_sha256"), str) and not hex64.fullmatch(record["action_sha256"]):
+        shape_errors.append("action_sha256")
+    for field in ("approvals_at", "issued_at"):
+        value = record.get(field)
+        if isinstance(value, bool) or not isinstance(value, int):
+            shape_errors.append(field)
+    if not isinstance(record.get("retroactive"), bool):
+        shape_errors.append("retroactive")
+    marker_name_value = record.get("marker_name", "")
+    if isinstance(marker_name_value, str) and (
+        marker_name_value != Path(marker_name_value).name
+        or not _re.fullmatch(r"[0-9a-f]{16}\.[0-9a-f]{16}", marker_name_value)
+    ):
+        shape_errors.append("marker_name")
+    marker_sha256_value = record.get("marker_sha256")
+    if isinstance(marker_sha256_value, str) and marker_sha256_value != MARKER_MISSING and not (
+        marker_sha256_value.startswith("sha256:") and hex64.fullmatch(marker_sha256_value[7:])
+    ):
+        shape_errors.append("marker_sha256")
+    if not isinstance(ttl_seconds, int) or isinstance(ttl_seconds, bool) or ttl_seconds < 1:
+        return {**base, "status": "schema_mismatch", "reason": "ttl_seconds"}
+    if shape_errors:
+        return {**base, "status": "schema_mismatch", "reason": f"field shape: {sorted(shape_errors)}"}
+    body = {item: record[item] for item in record if item not in ("receipt_sha256", "signature")}
+    if record.get("receipt_sha256") != "sha256:" + _canonical_hash(body):
+        return {**base, "status": "schema_mismatch", "reason": "self hash"}
+    key = _load_key(gate_root)
+    expected = hmac.new(key, str(record.get("receipt_sha256", "")).encode("utf-8"), hashlib.sha256).hexdigest()
+    if not hmac.compare_digest(str(record.get("signature", "")), expected):
+        return {**base, "status": "signature_mismatch"}
+    if current_time - int(record.get("approvals_at", 0)) > ttl_seconds:
+        return {**base, "status": "expiry_breached"}
+    marker = gate_root / "consumed" / str(record.get("marker_name", ""))
+    marker_sha256 = record.get("marker_sha256")
+    if marker_sha256 != MARKER_MISSING:
+        try:
+            actual = "sha256:" + _sha256_bytes(marker.read_bytes())
+        except OSError:
+            return {**base, "status": "marker_moved"}
+        if actual != marker_sha256:
+            return {**base, "status": "marker_changed"}
+    return {**base, "status": "ok", "process_id": record.get("process_id")}
