+    for record in _approval_rows(gate_root):
+        if record.get("run_id") == run_id and record.get("action_sha256") == action_sha256:
+            row = record
+            break
+    if row is None:
+        _block("BLOCK_RECEIPT_NO_APPROVAL", f"no signed approvals.jsonl row binds {run_id} / {action_sha256}")
+    current_time = int(time.time() if now is None else now)
+    marker_name = _marker_name(run_id, action_sha256)
+    marker = gate_root / "consumed" / marker_name
+    try:
+        marker_sha256 = "sha256:" + _sha256_bytes(marker.read_bytes())
+    except OSError:
+        marker_sha256 = MARKER_MISSING
+    record: dict[str, Any] = {
+        "schema": RECEIPT_SCHEMA,
+        "process_id": _nonempty(row.get("process_id"), "row.process_id"),
+        "run_id": run_id,
+        "action_sha256": action_sha256,
+        "approver": _nonempty(row.get("approver"), "row.approver"),
+        "approvals_at": int(row.get("issued_at", 0)),
+        "marker_name": marker_name,
+        "marker_sha256": marker_sha256,
+        "issued_at": current_time,
+        "retroactive": bool(retroactive) or current_time > int(row.get("expires_at", 0)),
+    }
+    _exact_keys(record, RECEIPT_KEYS, "receipt")
+    receipt_sha256 = "sha256:" + _canonical_hash(record)
+    key = _load_key(gate_root)
+    signature = hmac.new(key, receipt_sha256.encode("utf-8"), hashlib.sha256).hexdigest()
+    entry = {**record, "receipt_sha256": receipt_sha256, "signature": signature}
