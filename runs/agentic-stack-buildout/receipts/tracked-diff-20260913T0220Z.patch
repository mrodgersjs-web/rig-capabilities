+def issue_serial(
+    gate_root: Path,
+    run_id: str,
+    action_sha256: str,
+    *,
+    retroactive: bool = False,
+    now: int | None = None,
+) -> dict[str, Any]:
+    """Issue a signed date-of-trust receipt binding an existing approvals.jsonl
+    row to its consumed marker. Read-only toward approvals and consumed
+    markers: it never mints, renews, or consumes an approval. The receipt is
+    issued once (O_EXCL); a missing marker is recorded honestly as
+    MARKER_MISSING and stays issuable. `retroactive` is the caller's
+    declaration that this receipt attests a historical spend (the P3.5
+    backfill passes True); the flag is never downgraded — a receipt whose
+    bound approval had already expired at issue time records True regardless
+    of what was passed."""
