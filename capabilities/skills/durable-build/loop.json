{
  "closing_loop": {
    "from": [
      "V",
      "P"
    ],
    "max_iterations": 3,
    "on_exhaust": "escalate",
    "to": "B"
  },
  "coordinate": {
    "bms_mode": "A1",
    "diamond": "D2",
    "level": 4,
    "step": "B"
  },
  "doctrine_source": [
    "capabilities/data/rig-build-standard/policy.md",
    "capabilities/data/durable-repeatable-index/SCHEMA.md"
  ],
  "family": "engineering",
  "id": "durable-build",
  "kill_switch": {
    "max_iterations": 3,
    "max_stop_blocks": 2,
    "max_wall_minutes": 240
  },
  "modes": {
    "auto": {},
    "fast": {
      "skip_stages": []
    },
    "walk": {
      "stop_after_stage": true
    }
  },
  "name": "Durable build loop (D85-certified)",
  "outward_policy": {
    "require_gate_d": true
  },
  "packet": "BuildPacket",
  "schema": "rig.loop-skill.v11",
  "stages": [
    {
      "artifact": "intent.md",
      "gate": [
        {
          "path": "intent.md",
          "patterns": [
            "^## Goal",
            "^## Done-test",
            "^## Out of scope",
            "^## Budget"
          ],
          "type": "file_contains"
        },
        {
          "hint": "done-test must be executable (`- cmd:...`), not an adjective",
          "path": "intent.md",
          "pattern": "^## Done-test[^\\n]*\\n[^\\n]*\\b(cmd|test|grep):",
          "type": "regex"
        }
      ],
      "id": "I",
      "name": "Intent"
    },
    {
      "artifact": "diagnosis.md",
      "gate": [
        {
          "path": "diagnosis.md",
          "patterns": [
            "^## Cell",
            "^## Level fits",
            "^## Mode necessity",
            "^## Owner",
            "^## Rejected fits"
          ],
          "type": "file_contains"
        },
        {
          "hint": "name the T-rule and the carrier from tool_selection.select_framework; a keyword guess is not an owner",
          "path": "diagnosis.md",
          "pattern": "(?i)^## Owner[^\\n]*\\n[^\\n]*\\bT[1-8]\\b",
          "type": "regex"
        },
        {
          "hint": "state which coordinate/mode fits were rejected and why (all seven level fits, four mode assessments)",
          "path": "diagnosis.md",
          "pattern": "(?i)^## Rejected fits[^\\n]*\\n[^\\n]*\\b(L[1-7]-D[1-3]|A[2-4])\\b",
          "type": "regex"
        }
      ],
      "id": "D",
      "name": "Diagnosis and owner"
    },
    {
      "artifact": "build.md",
      "gate": [
        {
          "min": 1,
          "type": "files_written_min"
        },
        {
          "path": "build.md",
          "patterns": [
            "^## Change",
            "^## Determinism",
            "^## Artifacts"
          ],
          "type": "file_contains"
        },
        {
          "hint": "paste the D85 inventory/classify/score invocation for this build",
          "path": "build.md",
          "pattern": "(?i)inventory|classify|score",
          "type": "regex"
        }
      ],
      "id": "B",
      "name": "Build"
    },
    {
      "artifact": "verify.md",
      "gate": [
        {
          "min": 1,
          "type": "checks_green"
        },
        {
          "min": 1,
          "type": "planted_failure"
        },
        {
          "min": 1,
          "type": "independent_verdict"
        },
        {
          "path": "verify.md",
          "patterns": [
            "^## Checks",
            "^## Planted failure",
            "^## Independent verdict"
          ],
          "type": "file_contains"
        }
      ],
      "id": "V",
      "name": "Verify"
    },
    {
      "artifact": "proof.md",
      "gate": [
        {
          "build": "build.json",
          "certificate": "certificate.json",
          "root": ".",
          "type": "d85_certified"
        },
        {
          "diagnosis": "diagnosis.json",
          "index": "diagnosis_index.jsonl",
          "type": "build_diagnosis"
        },
        {
          "type": "sealed"
        }
      ],
      "id": "P",
      "name": "Proof"
    }
  ],
  "version": "1.0.0"
}
