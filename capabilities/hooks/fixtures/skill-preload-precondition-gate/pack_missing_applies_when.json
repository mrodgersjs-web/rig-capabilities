{
  "task": {
    "id": "pack-missing-applies-when",
    "goal": "triage the failing nightly",
    "requirements": { "artifact-path": "build/" },
    "counterparts": [{ "id": "rig-capabilities", "version": "2.4.1" }]
  },
  "state": {
    "repo_kind": "npm",
    "container_runtime": "docker",
    "python_version": "3.13.1"
  },
  "candidates": [
    {
      "id": "nightly-triage",
      "version": "2.1.0",
      "activation": "a nightly run finished RED",
      "defaults": { "artifact-path": "build/reports/", "output-format": "json" },
      "counterparts": [{ "id": "rig-capabilities", "version_band": ">=2.0,<3.0" }]
    },
    {
      "id": "npm-audit-triage",
      "version": "0.9.2",
      "activation": "an npm audit finding blocks the release lane",
      "applies_when": [{ "field": "repo_kind", "equals": "npm" }],
      "defaults": { "artifact-path": "build/", "output-format": "json" },
      "counterparts": []
    }
  ]
}
