#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

SKILL_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SKILL_ROOT))
REPO_ROOT = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO_ROOT))

from d85 import AdmissionBlock, build_inventory, compare_inventory  # noqa: E402
from d85_gates import (  # noqa: E402
    arm_gate_d,
    classify_process,
    score_process,
    verify_surfaces,
)
from tool_selection import (  # noqa: E402
    ToolSelectionBlock,
    certify_build,
    check_build_checklist,
    select_framework,
)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="rig-determinism-85")
    commands = parser.add_subparsers(dest="command", required=True)
    inventory = commands.add_parser("inventory")
    inventory.add_argument("process_id")
    compare = commands.add_parser("compare")
    compare.add_argument("process_id")
    compare.add_argument("inventory_file", type=Path)
    classify = commands.add_parser("classify")
    classify.add_argument("process_id")
    score = commands.add_parser("score")
    score.add_argument("process_id")
    gate = commands.add_parser("gate-d")
    gate.add_argument("process_id")
    gate.add_argument("--action", type=Path, required=True)
    commands.add_parser("wiring")
    select_cmd = commands.add_parser("select")
    select_cmd.add_argument("evidence_file", type=Path)
    checklist = commands.add_parser("checklist")
    checklist.add_argument("build_file", type=Path)
    checklist.add_argument("--root", type=Path, default=None)
    checklist.add_argument("--process-id", default=None,
                           help="bind the verdict to the current inventory hash of this process")
    commands.add_parser("estate-validate")
    verify_cmd = commands.add_parser("verify-cert")
    verify_cmd.add_argument("build_file", type=Path)
    verify_cmd.add_argument("certificate_file", type=Path)
    verify_cmd.add_argument("--root", type=Path, default=None)
    admit_request = commands.add_parser("admit-request")
    admit_request.add_argument("build_file", metavar="BUILD")
    admit_request.add_argument("--process-id", default=None)
    admit_request.add_argument("--path", action="append", default=[], dest="paths",
                               help="exact writable output (repeatable); never implied by --launcher")
    admit_request.add_argument("--session-key", required=True)
    admit_request.add_argument("--launcher", action="append", default=None, dest="launchers",
                               help="script whose CONTENT is signed as this job's identity (repeatable)")
    admit_approve = commands.add_parser("admit-approve")
    admit_approve.add_argument("--phrase", default=None)
    commands.add_parser("admit-status")
    d85_run = commands.add_parser("d85-run")
    d85_run.add_argument("script", metavar="SCRIPT")
    d85_run.add_argument("script_args", nargs=argparse.REMAINDER)
    return parser


def _submitted_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise AdmissionBlock(
                "SUBMITTED_MALFORMED", f"duplicate JSON key {key!r}"
            )
        value[key] = item
    return value


def _submitted(path: Path):
    try:
        value = json.loads(
            path.read_text(encoding="utf-8"),
            object_pairs_hook=_submitted_object,
        )
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AdmissionBlock("SUBMITTED_MALFORMED", f"{path}: {exc}") from exc
    if not isinstance(value, dict):
        raise AdmissionBlock("SUBMITTED_MALFORMED", f"{path}: expected object")
    return value


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    if args.command in {"admit-request", "admit-approve", "admit-status", "d85-run"}:
        from rig_capabilities import d85_admission

        try:
            if args.command == "admit-request":
                result = d85_admission.admit_request(
                    args.build_file, args.process_id, args.paths, args.session_key,
                    launchers=args.launchers,
                )
            elif args.command == "admit-approve":
                result = d85_admission.admit_approve(args.phrase)
            elif args.command == "admit-status":
                result = d85_admission.admit_status()
            else:
                return d85_admission.run_launcher([args.script, *args.script_args])
        except d85_admission.AdmissionDenied as exc:
            print(str(exc), file=sys.stderr)
            return 2
        print(json.dumps(result, sort_keys=True))
        return 0

    try:
        if args.command == "select":
            result = select_framework(_submitted(args.evidence_file))
        elif args.command == "checklist":
            build = _submitted(args.build_file)
            result = check_build_checklist(build, root=args.root)
            if args.process_id:
                result = certify_build(build, args.process_id, root=args.root)
            elif result.get("verdict") == "CHECKLIST_PASS":
                result = dict(
                    result,
                    verdict="CHECKLIST_BLOCK",
                    binding_reason=(
                        "unbound verdict: --process-id is required — only a bound "
                        "CHECKLIST_PASS is an enforcement verdict"
                    ),
                )
            if result.get("verdict") != "CHECKLIST_PASS":
                print(json.dumps(result, sort_keys=True))
                return 2
        elif args.command == "verify-cert":
            from tool_selection import verify_certification

            result = verify_certification(
                _submitted(args.build_file), _submitted(args.certificate_file), root=args.root
            )
            if result.get("verdict") != "CERTIFICATION_VERIFIED":
                print(json.dumps(result, sort_keys=True))
                return 2
        elif args.command == "estate-validate":
            import estate_validator
            return estate_validator.main()
        elif args.command == "inventory":
            result = build_inventory(args.process_id)
        elif args.command == "compare":
            result = compare_inventory(args.process_id, _submitted(args.inventory_file))
        elif args.command == "classify":
            result = classify_process(args.process_id)
        elif args.command == "score":
            result = score_process(args.process_id)
        elif args.command == "gate-d":
            result = arm_gate_d(args.process_id, _submitted(args.action))
        else:
            result = verify_surfaces()
    except ToolSelectionBlock as exc:
        print(json.dumps(exc.as_dict(), sort_keys=True))
        return 2
    except AdmissionBlock as exc:
        print(json.dumps(exc.as_dict(), sort_keys=True))
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
