+def _dup_family(msg, window_s=DUP_WINDOW_S):
+    """Newest same-text job within window_s, or None. Text match is exact on the
+    stripped message (the same key the watchdog's supersede check uses)."""
+    now = time.time()
+    best = None
+    for name in sorted(os.listdir(JOBS)):
+        mp = os.path.join(JOBS, name, "meta.json")
+        if not os.path.exists(mp):
+            continue
+        try:
+            meta = json.load(open(mp))
+        except Exception:
+            continue
+        if (meta.get("message") or "").strip() != msg:
+            continue
+        if now - meta.get("started", 0) <= window_s:
+            best = name
+    return best
