        {
          "hint": "## Class must name one of: send publish deploy push merge spend credential destructive export dns",
          "path": "classify.md",
          "pattern": "^## Class[^\\n]*\\n[^\\n]*\\b(send|publish|deploy|push|merge|spend|credential|destructive|export|dns)\\b",
          "type": "regex"
        }
      ],
      "id": "C",
      "name": "Classify"
    },
    {
      "artifact": "dormant.md",
      "gate": [
        {
          "path": "dormant.md",
          "patterns": [
            "^## Staged",
            "^## Zero-outbound-proof"
          ],
          "type": "file_contains"
        },
        {
          "hint": "paste the command + output that proves nothing has gone out yet (sent=0, dry-run, staged only)",
          "path": "dormant.md",
          "pattern": "^## Zero-outbound-proof[^\\n]*\\n(?:[^\\n]*\\n)*?\\s*[-*]\\s+\\S",
          "type": "regex"
        }
      ],
      "id": "D",
      "name": "Dormant"
    },
    {
      "artifact": "request.md",
      "gate": [
        {
          "path": "request.md",
