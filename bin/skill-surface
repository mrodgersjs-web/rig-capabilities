    \bjacob\b | \bnil\b | pewaukee | \bjames\b | \bjennifer\b | \bcoby\b | \bkobe\b | skonord | ideawake | ideaweek | \bkyle\b | puckhaber | \bluca\b
  | \bsk-[A-Za-z0-9_-]{16,} | \b(?:ghp|gho|ghs|xox[bapr])[-_][A-Za-z0-9-]{10,} | \bAKIA[0-9A-Z]{16}\b
  | -----BEGIN | \b[A-Fa-f0-9]{32,}\b | \b[A-Za-z0-9+/]{40,}={0,2}
  | \bpass(?:word|code)\s*[:=] | \bssn\b | social\s+security | routing\s+number | account\s+number
  | credit\s+card | \biban\b
  | [\w.+-]+@[\w-]+\.[A-Za-z]{2,}
  | (?:\+?1[\s.-]?)?\(?\d{3}\)?[\s.-]\d{3}[\s.-]\d{4}
  | \$\s?\d[\d,.]*\s?[kKmM]?\b | \b\d{2,3}\s?[kK]\b
  | diagnos | prescription | medical\s+record | \bpatient
)""", re.I | re.X)

# Lane rules run before any model: naming a protected lane decides the meta deterministically.
# Order matters: Jacob's minor lane takes precedence over every other lane.
LANE_RULES = [
    (re.compile(r"\bjacob\b|#79\b|\bhudl\b|\bncsa\b|jakerodgers2029|pewaukee|red ?zone|\bnil\b", re.I), "jacob-x-growth"),
    (re.compile(r"\bcoby\b|\bkobe\b|skonord|ideawake|ideaweek", re.I), "ideawake-linkedin-weekly"),
]

STOP = set("a an the to for of and or in on at by with from my me i this that it is be do make use "
           "run get how what please can you your our we need want help some any all".split())


# ---------------------------------------------------------------- small helpers
def now():
    return datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")


def load():
    with open(MAN) as f:
        return json.load(f)


def save(m):
    tmp = MAN + ".tmp"
    with open(tmp, "w") as f:
        json.dump(m, f, indent=1)
    os.replace(tmp, MAN)


def read(p):
    with open(p, encoding="utf-8", errors="replace") as f:
        return f.read()


def write_if_changed(p, text, dry=False):
    old = read(p) if os.path.isfile(p) else None
    if old == text:
        return False
    if not dry:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        tmp = p + ".ss-tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, p)
    return True


def is_foreign(skill_dir):
    """A skill whose folder or SKILL.md is a symlink lives in another store: never write there."""
    return os.path.islink(skill_dir) or os.path.islink(os.path.join(skill_dir, "SKILL.md"))


def frontmatter(path):
    try:
        txt = read(path)[:30000]
    except OSError:
        return {}
    if not txt.startswith("---"):
        return {}
    end = txt.find("\n---", 3)
    if end < 0:
        return {}
    lines, out, i = txt[3:end].split("\n"), {}, 0
    while i < len(lines):
        mm = re.match(r"^([A-Za-z_][\w-]*):\s?(.*)$", lines[i])
        i += 1
        if not mm:
            continue
        key, val, cont = mm.group(1), mm.group(2).strip(), []
        while i < len(lines) and (lines[i][:1] in (" ", "\t") or not lines[i].strip()):
            cont.append(lines[i].strip())
            i += 1
        if key not in ("name", "description"):
            continue
        if val in ("", ">", ">-", "|", "|-", ">+", "|+"):
            val = " ".join(c for c in cont if c)
        elif val[:1] == '"':
            full = " ".join([val] + [c for c in cont if c])
            try:
                val = json.loads(full)
            except Exception:
                val = full.strip('"')
        elif val[:1] == "'":
            val = " ".join([val] + [c for c in cont if c]).strip("'").replace("''", "'")
        else:
            val = " ".join([val] + [c for c in cont if c])
        out[key] = re.sub(r"\s+", " ", str(val)).strip()
    return out


BOILER = re.compile(r"JEV[- ]FIRST|rig-s1gate \(Jev\)|DEFERRED (?:is the only|when the)|findable at task start|"
                    r"binding before any work|never a guessed verdict|classifier is down|^Child of |"
                    r"Part of (?:jev-ten-levels|the rig-adrien)|load that (?:meta skill|first)", re.I)


def purpose(desc, limit=230):
    if not desc:
        return ""
    parts = [p for p in re.split(r"(?<=[.;])\s+", desc) if p and not BOILER.search(p)]
    s = " ".join(parts).strip() or desc
    s = re.sub(r"^Main skill of [\w-]+ for ([^:]+):\s*", lambda x: x.group(1)[:1].upper() + x.group(1)[1:] + ": ", s)
    s = re.sub(r"^Sub-skill of [\w-]+:\s*", "", s)
    if len(s) > limit:
        s = s[:limit].rsplit(" ", 1)[0].rstrip(",;:") + "..."
    return s[:1].upper() + s[1:]


def strays(m):
    metas = set(m["metas"])
    out = [(n, os.path.join(USER, n)) for n in sorted(os.listdir(USER))
           if not n.startswith(".") and n not in metas]
    for n in sorted(os.listdir(ROOT)):
        p = os.path.join(ROOT, n)
        if not n.startswith(".") and n not in ROOT_KEEP and os.path.exists(os.path.join(p, "SKILL.md")):
            out.append((n, p))
    return out


# ---------------------------------------------------------------- model of the tree
class Tree:
    def __init__(self, m):
        self.m, self.E, self.metas = m, m["entries"], list(m["metas"])
        self.kids, self.subs = {mm: [] for mm in self.metas}, {}
        for n, e in self.E.items():
            if e["role"] == "skill":
                self.kids.setdefault(e["meta"], []).append(n)
            elif e["role"] == "sub":
                self.subs.setdefault(e["parent"], []).append(n)
        key = lambda x: (-self.E[x].get("uses", 0), x)
        for v in list(self.kids.values()) + list(self.subs.values()):
            v.sort(key=key)
        self.lane = {mm: sum(e.get("uses", 0) for e in self.E.values() if e["meta"] == mm) for mm in self.metas}
        self.ranked = sorted(self.metas, key=lambda mm: (-self.lane[mm], mm))
        self.rank = {mm: i + 1 for i, mm in enumerate(self.ranked)}

    def dir(self, n):
        return os.path.join(USER if self.E[n]["role"] == "meta" else LIB, n)

    def layer(self, n):
        return {"meta": 1, "skill": 2, "sub": 3}[self.E[n]["role"]]

    def crumbs(self, n):
        e = self.E[n]
        if e["role"] == "meta":
            return [n]
        if e["role"] == "skill":
            return [e["meta"], n]
        return [e["meta"], e["parent"], n]

    def load(self, n):
        return self.E[n].get("load")

    def info(self, meta):
        return META_INFO.get(meta, (meta, meta, "Outward, paid or destructive steps stop at Gate-D."))


def refresh(m):
    """Recompute filesystem facts for every entry (paths, symlinks, purpose, load, dead)."""
    t = Tree(m)
    for n, e in m["entries"].items():
        d = t.dir(n)
        e["path"] = d
        e["symlink"] = os.readlink(d) if os.path.islink(d) else None
        sk = os.path.join(d, "SKILL.md")
        e.pop("command_file", None)
        e.pop("alt", None)
        if os.path.isfile(sk):
            fm = frontmatter(sk)
            e["purpose"] = purpose(fm.get("description", "")) or purpose(e.get("description", "")) or n
            e["load"], e["dead"] = sk, False
        elif n in COMMAND_FALLBACK and os.path.isfile(COMMAND_FALLBACK[n]):
            cf = COMMAND_FALLBACK[n]
            first = next((ln.strip("# ").strip() for ln in read(cf).splitlines()
                          if ln.strip() and not ln.startswith("---") and ":" not in ln[:20]), "")
            e["purpose"] = purpose(frontmatter(cf).get("description", "") or first) or f"Command file for {n}"
            e["load"], e["dead"], e["command_file"] = COMMAND_FALLBACK[n], False, COMMAND_FALLBACK[n]
        else:
            e["purpose"] = purpose(e.get("description", "")) or n
            e["load"], e["dead"] = None, True
            if n in ALT:
                e["alt"] = ALT[n]
        sk2 = e.get("load")
        try:
            body = read(sk2) if sk2 and os.path.isfile(sk2) else ""
        except OSError:
            body = ""
        e["tested"] = bool(re.search(r"^#{1,3} *done[- ]?test|^done_when:|\bdone_when\b|^#{1,3} *(executable )?done test", body, re.I | re.M))
        if n in RETIRED:
            e["retired"] = RETIRED[n]
        else:
            e.pop("retired", None)
        if n in MERGED:
            e["merged_into"] = MERGED[n]
        else:
            e.pop("merged_into", None)
        if e["role"] == "meta":
            e["purpose"] = t.info(n)[0]
    return Tree(m)


# ---------------------------------------------------------------- generated text
def nav_card(t, n):
    e = t.E[n]
    meta = e["meta"]
    blurb, _, gate = t.info(meta)
    layer = t.layer(n)
    head = {"name": n, "layer": layer, "meta": meta, "parent": e.get("parent")}
    trail = " > ".join(t.crumbs(n))
    kind = "layer 2 skill" if layer == 2 else "layer 3 sub-skill"
    lines = [f"# {n}", f"<!-- skill-surface-nav {json.dumps(head)} -->", "",
             f"- **Where:** {trail}  ({kind}; meta #{t.rank[meta]} of {len(t.metas)}; used in {e.get('uses', 0)} chats)",
             f"- **Call it:** `/{n}` or \"use {n}\"",
             f"- **Load:** {e['load'] if e.get('load') else 'DEAD LINK (target missing): use ' + (e.get('alt') or 'skill-surface find')}",
             f"- **Purpose:** {e.get('purpose', '')}",
             f"- **Done-test:** {'yes' if e.get('tested') else 'none yet (draft quality: verify the output yourself)'}",
             f"- **Rules first:** {gate} Meta gates: {t.dir(meta)}/SKILL.md",
             f"- **Outward, paid, destructive or public steps stop at Gate-D (Mike's approval).**",
             f"- **Jev first:** typed judgments this skill makes (classify, rank, route, gate) go to `rig-s1gate` "
             f"before any frontier model; if Jev is down the verdict is DEFERRED, never guessed."]
    if e.get("command_file"):
        lines.append(f"- **Note:** no skill folder; this one is a command file.")
    if e.get("retired"):
        lines.append(f"- **RETIRED, do not use:** {e['retired']}")
    if e.get("merged_into"):
        lines.append(f"- **Merged into `{e['merged_into']}` for routing:** the router never picks this one; a direct call still loads it for its unique content.")
    lines.append(f"- **Owner agent:** {OWNERS.get(meta, 'none')} (skill surface librarian: {LIBRARIAN})")
    lines += ["", "## Up"]
    if layer == 3:
        par = e["parent"]
        lines.append(f"- parent skill `{par}`: {t.E[par].get('load')}")
    lines.append(f"- meta `{meta}` ({blurb}): {t.dir(meta)}/SKILL.md, map {LAYERS}/{meta}.md")
    kids = t.subs.get(n, [])
    if kids:
        lines += ["", "## Down (sub-skills)"]
        for k in kids:
            ke = t.E[k]
            lines.append(f"- `{k}` ({ke.get('uses', 0)} chats): {ke.get('purpose', '')}")
            lines.append(f"  - load: {ke.get('load') or 'DEAD LINK'}")
    sib = [s for s in (t.subs.get(e["parent"], []) if layer == 3 else t.kids.get(meta, [])) if s != n]
    if sib:
        lines += ["", "## Siblings", ", ".join(f"`{s}`" for s in sib)]
    return "\n".join(lines) + "\n"


def meta_map(t, meta):
    blurb, _, gate = t.info(meta)
    L = [f"# {meta}: layer map", "", JEV_LINE, "",
         f"Meta-skill #{t.rank[meta]} of {len(t.metas)}: {blurb}. Owner agent: {OWNERS.get(meta, 'none')}. Rules for everything below: {gate}",
         "Layer 1 = this meta. Layer 2 = the skills below. Layer 3 = sub-skills under their parent skill. "
         "Read ONE layer-2 skill that fits, then only the sub-skill you need. Call any of them directly as "
         "`/<name>`; every one has a nav card at " + NAV + "/<name>.md.", ""]
    kids = t.kids.get(meta, [])
    if not kids:
        L.append("_No child skills: this meta is a single high-traffic front door._")
    for k in kids:
        ke = t.E[k]
        L.append(f"## {k}")
        L.append(f"- ({ke.get('uses', 0)} chats) {ke.get('purpose', '')}")
        L.append(f"  - load: {ke.get('load') or 'DEAD LINK: ' + (ke.get('alt') or 'see skill-surface find')}")
        for s in t.subs.get(k, []):
            se = t.E[s]
            L.append(f"  - sub `{s}` ({se.get('uses', 0)} chats): {se.get('purpose', '')}")
            L.append(f"    - load: {se.get('load') or 'DEAD LINK: ' + (se.get('alt') or 'see skill-surface find')}")
        L.append("")
    return "\n".join(L).rstrip() + "\n"


def block_for(t, n):
    e, layer = t.E[n], t.layer(n)
    meta = e["meta"]
    if layer == 1:
        kids = t.kids.get(meta, [])
        top = ", ".join(f"`{k}`" for k in kids[:6])
        nsub = sum(len(t.subs.get(k, [])) for k in kids)
        body = (f"This is visible meta-skill #{t.rank[meta]} of Mike's {len(t.metas)} layer-1 metas. Its {len(kids)} skills and {nsub} "
                f"sub-skills are hidden from the Aside menu and live in `{LIB}/<name>/SKILL.md`; the full map with "
                f"paths is `LAYERS.md` next to this file." + (f" Most-used children: {top}." if kids else "") +
                f" Call any child directly as `/<name>`. Route a task: `{SELF} route \"<task>\"`.")
        title = "## Layer map (Aside skill surface)"
    else:
        trail = " > ".join(f"`{c}`" for c in t.crumbs(n))
        up = (f" then the parent `{t.E[e['parent']].get('load')}`" if layer == 3 else "")
        kids = t.subs.get(n, [])
        down = (" Sub-skills: " + ", ".join(f"`{k}`" for k in kids) + "." if kids else "")
        body = (f"Layer {layer} {'skill' if layer == 2 else 'sub-skill'}: {trail}. Before acting, read the meta's gates "
                f"in `{t.dir(meta)}/SKILL.md`{up}.{down} Nav card with paths and siblings: `{NAV}/{n}.md`. "
                f"Call directly as `/{n}`.")
        title = "## Where this skill sits (Aside skill surface)"
    return f"{B}\n{title}\n{body}\n{E_}\n"


def index_md(t):
    L = ["# Skill index: call any skill by name", "",
         f"Call: `/<name>` or \"use <name>\". Resolve: `{SELF} where <name>` (fuzzy names are fine). "
         f"Route a task: `{SELF} route \"<task>\"`. Layer 1 = visible meta, 2 = skill, 3 = sub-skill.", "",
         "| name | layer | where | purpose |", "|---|---|---|---|"]
    for n in sorted(t.E):
        e = t.E[n]
        trail = " > ".join(t.crumbs(n)[:-1]) or "(menu)"
        p = (e.get("purpose") or "").replace("|", "/")
        if e.get("dead"):
            p = "DEAD LINK. " + (f"Use `{e['alt']}`." if e.get("alt") else "")
        if e.get("retired"):
            p = "RETIRED: " + e["retired"]
        L.append(f"| `{n}` | {t.layer(n)} | {trail} | {p[:140]} |")
    return "\n".join(L) + "\n"


def tree_md(t):
    total = sum(e.get("uses", 0) for e in t.E.values())
    L = [f"# Mike's skill surface: {len(t.metas)} meta-skills", "", JEV_LINE, "",
         f"Ranked by chats that used the lane ({total} skill uses across {t.m.get('usage_chats', 2996):,} Aside chats, counted {str(t.m.get('usage_counted', '2026-09-29'))[:10]}). "
         f"Layer 1 = {len(t.metas)} visible metas; layer 2 = {sum(len(v) for v in t.kids.values())} skills; layer 3 = "
         f"{sum(len(v) for v in t.subs.values())} sub-skills, hidden in {LIB}. Call any by name (`/<name>`); "
         f"find names in INDEX.md. Tool: `{SELF} where|find|route|tree|verify`.", "",
         "| # | Meta-skill | Use it for | Lane uses | Skills | Sub-skills |", "|---|---|---|---|---|---|"]
    for mm in t.ranked:
        kids = t.kids.get(mm, [])
        L.append(f"| {t.rank[mm]} | `{mm}` | {t.info(mm)[0]} | {t.lane[mm]} | {len(kids)} | "
                 f"{sum(len(t.subs.get(k, [])) for k in kids)} |")
    L += ["", "## Full tree", ""]
    for mm in t.ranked:
        L.append(f"### {t.rank[mm]}. {mm}")
        for k in t.kids.get(mm, []):
            s = t.subs.get(k, [])
            L.append(f"- {k}" + (" > " + ", ".join(s) if s else ""))
        L.append("")
    return "\n".join(L).rstrip() + "\n"


# ---------------------------------------------------------------- build / verify
ROUTING_HEAD = "<!-- skill-surface:routing generated; edits are overwritten by build -->"
PATH_RE = re.compile(r"(?:~|/Users/[A-Za-z0-9_.-]+)/[A-Za-z0-9_./\-]+")


def routing_md(t, meta):
    """references/routing.md for one meta: the full child table, generated from the manifest."""
    def one(n):
        e = t.E[n]
        return " ".join((e.get("purpose") or "").split()).replace("|", "/")[:240]
    rows = []
    for n in t.kids.get(meta, []):
        e = t.E[n]
        if e.get("retired") or e.get("merged_into"):
            continue
        subs = [s for s in t.subs.get(n, []) if not t.E[s].get("retired")]
        load_ = "dead link" + (f" (use {e['alt']})" if e.get("alt") else "") if e.get("dead") else f"`{e.get('load') or ''}`"
        rows.append(f"| {n} | {load_} | {one(n)} | {', '.join(subs) if subs else 'Leaf: no subskill required'} |")
    head = [ROUTING_HEAD, f"# {meta}: routing table", "",
            f"{len(rows)} layer-2 children of `{meta}`, generated from `skill-library/_manifest.json` by `skill-surface build`.",
            "Pick ONE row and load its path. Load only the sub-skill the child names. Do not load the rows as skills.",
            "If no row fits: `skill-surface find <words>`, then `skill-surface file <name> --meta <meta> --apply` to register a new skill.",
            "", "| Skill | Load | One-liner | Sub-skills |", "|---|---|---|---|"]
    return "\n".join(head + rows) + "\n"


def routing_targets(meta):
    """Where a meta's routing table must exist: its own folder, plus the Claude copy when that SKILL.md points at one."""
    out = []
    d = os.path.join(USER, meta)
    if not os.path.islink(d):
        out.append(os.path.join(d, "references", "routing.md"))
    # Harness copies (~/.claude, ~/.codex, ...) are rig-skill sync targets: writing there makes
    # build and sync undo each other. Write the canonical registry copy instead; sync carries it.
    cd = os.path.join(HOME, ".rig", "universal-skills-registry", "skills", meta)
    cp = os.path.join(cd, "references", "routing.md")
    if os.path.isdir(cd) and not os.path.islink(cd) and os.path.isfile(os.path.join(cd, "SKILL.md")) \
            and f"{meta}/references/routing.md" in read(os.path.join(cd, "SKILL.md")) \
            and (not os.path.exists(cp) or read(cp).startswith(ROUTING_HEAD)):
        out.append(cp)
    return out


def dangling_paths(path):
    """Absolute or ~ paths named in a file that do not exist (placeholders and globs ignored)."""
    out = []
    for raw in sorted(set(PATH_RE.findall(read(path)))):
        q = raw.rstrip(".,):;`'\"")
        if any(c in q for c in "<*{$"):
            continue
        q = os.path.expanduser(q) if q.startswith("~") else q
        if not os.path.exists(q):
            out.append(q)
    return out


def build(dry=False, quiet=False):
    m = load()
    t = refresh(m)
    changed = {"nav": 0, "layers": 0, "blocks": 0, "index": 0, "tree": 0, "pointer": 0,
               "skipped_foreign": 0}
    live_navs = set()
    for n, e in t.E.items():
        if e["role"] == "meta":
            continue
        live_navs.add(n + ".md")
        changed["nav"] += write_if_changed(os.path.join(NAV, n + ".md"), nav_card(t, n), dry)
    if os.path.isdir(NAV):
        for f in os.listdir(NAV):
            if f.endswith(".md") and f not in live_navs and not dry:
                os.remove(os.path.join(NAV, f))
    for mm in t.metas:
        text = meta_map(t, mm)
        changed["layers"] += write_if_changed(os.path.join(LAYERS, mm + ".md"), text, dry)
        d = os.path.join(USER, mm)
        if not os.path.islink(d):  # a real Aside folder may hold LAYERS.md even if its SKILL.md is a link
            changed["layers"] += write_if_changed(os.path.join(d, "LAYERS.md"), text, dry)
        rt = routing_md(t, mm)
        for rp in routing_targets(mm):
            changed["routing"] = changed.get("routing", 0) + write_if_changed(rp, rt, dry)
    for n, e in t.E.items():
        d = t.dir(n)
        sk = os.path.join(d, "SKILL.md")
        if not os.path.isfile(sk):
            continue
        if is_foreign(d):
            changed["skipped_foreign"] += 1
            continue
        txt = read(sk)
        if e["role"] != "meta":
            bkp = os.path.join(BK, "build", n, "SKILL.md")
            if not os.path.exists(bkp) and not dry:
                os.makedirs(os.path.dirname(bkp), exist_ok=True)
                with open(bkp, "w", encoding="utf-8") as f:
                    f.write(BLOCK_RE.sub("", txt))
        blk = block_for(t, n)
        new = BLOCK_RE.sub(lambda _: blk, txt, count=1) if B in txt else txt.rstrip("\n") + "\n\n" + blk
        changed["blocks"] += write_if_changed(sk, new, dry)
    idx = {n: {"layer": t.layer(n), "meta": e["meta"], "parent": e.get("parent"), "load": e.get("load"),
               "dead": e.get("dead", False), "alt": e.get("alt"), "retired": e.get("retired"), "tested": e.get("tested", False), "purpose": e.get("purpose"),
               "uses": e.get("uses", 0)} for n, e in t.E.items()}
    changed["index"] += write_if_changed(INDEX_JSON, json.dumps(idx, indent=1, sort_keys=True) + "\n", dry)
    changed["index"] += write_if_changed(os.path.join(LIB, "INDEX.md"), index_md(t), dry)
    changed["tree"] += write_if_changed(os.path.join(LIB, "TREE.md"), tree_md(t), dry)
    cur = read(AGENTS) if os.path.exists(AGENTS) else ""
    changed["pointer"] += write_if_changed(AGENTS, pointer_add(cur, aside_pointer(t)), dry)
    if not dry:
        m["built"] = now()
        save(m)
    if not quiet:
        print(("would change" if dry else "changed") + ": " + json.dumps(changed))
        print(f"entries {len(t.E)} | metas {len(t.metas)} | skills {sum(len(v) for v in t.kids.values())} | "
              f"sub-skills {sum(len(v) for v in t.subs.values())} | dead {sum(1 for e in t.E.values() if e.get('dead'))}")
    return 0


def verify():
    m = load()
    t = Tree(m)
    fails, notes = [], []
    vis = sorted(n for n in os.listdir(USER) if not n.startswith("."))
    if vis != sorted(t.metas):
        fails.append(f"visible set is not the metas: extra={sorted(set(vis) - set(t.metas))} "
                     f"missing={sorted(set(t.metas) - set(vis))}")
    for n, p in strays(m):
        fails.append(f"stray at top level: {p}")
    try:
        idx = json.load(open(INDEX_JSON))
    except Exception as ex:
        idx = {}
        fails.append(f"index unreadable: {ex}")
    if set(idx) != set(t.E):
        fails.append(f"index does not match manifest: {len(set(t.E) ^ set(idx))} names differ")
    for mm in t.metas:
        if not os.path.isfile(os.path.join(USER, mm, "SKILL.md")):
            fails.append(f"meta has no SKILL.md: {mm}")
        if not os.path.isfile(os.path.join(LAYERS, mm + ".md")):
            fails.append(f"meta has no layer map: {mm}")
        if mm not in META_INFO:
            fails.append(f"meta has no routing text in META_INFO: {mm}")
        if mm not in OWNERS:
            fails.append(f"meta has no owner agent: {mm}")
        sk_ = os.path.join(USER, mm, "SKILL.md")
        if os.path.isfile(sk_):
            for q in dangling_paths(sk_):
                fails.append(f"meta SKILL.md names a path that does not exist: {mm} -> {q}")
        if not os.path.islink(os.path.join(USER, mm)) and not os.path.isfile(os.path.join(USER, mm, "references", "routing.md")):
            fails.append(f"meta has no generated references/routing.md: {mm}")
    if os.path.isdir(LIB):
        for d_ in sorted(os.listdir(LIB)):
            if d_.startswith(("_", ".")) or d_ in t.E:
                continue
            if os.path.isfile(os.path.join(LIB, d_, "SKILL.md")):
                fails.append(f"library skill not registered in the manifest (run: skill-surface file {d_} --meta <meta> --apply): {d_}")
    for n, e in t.E.items():
        d = t.dir(n)
        sk = os.path.join(d, "SKILL.md")
        if e["role"] != "meta":
            if not os.path.lexists(d):
                fails.append(f"missing from library: {n}")
            if e.get("meta") not in t.metas:
                fails.append(f"unknown meta for {n}: {e.get('meta')}")
            if e["role"] == "sub":
                p = t.E.get(e.get("parent"))
                if not p or p["role"] != "skill" or p["meta"] != e["meta"]:
                    fails.append(f"bad parent: {n} -> {e.get('parent')}")
            elif e.get("parent"):
                fails.append(f"layer-2 skill has a parent: {n}")
            nav = os.path.join(NAV, n + ".md")
            if not os.path.isfile(nav):
                fails.append(f"no nav card: {n}")
            else:
                mm_ = NAV_RE.search(read(nav))
                want = {"name": n, "layer": t.layer(n), "meta": e["meta"], "parent": e.get("parent")}
                if not mm_ or json.loads(mm_.group(1)) != want:
                    fails.append(f"nav card out of date: {n}")
            if e.get("dead"):
                notes.append(f"dead link kept on record: {n}" + (f" (use {e['alt']})" if e.get("alt") else ""))
            elif not (e.get("load") and os.path.isfile(e["load"])):
                fails.append(f"load path does not resolve: {n} -> {e.get('load')}")
        if os.path.isfile(sk):
            cnt = read(sk).count(B)
            if is_foreign(d):
                if cnt:
                    fails.append(f"marker written into a foreign store: {n} -> {os.path.realpath(sk)}")
            elif cnt != 1:
                fails.append(f"real SKILL.md without exactly one position block: {n} ({cnt})")
    for f in fails:
        print("FAIL", f)
    for x in notes:
        print("note", x)
    print(f"verify: {'RED' if fails else 'GREEN'} ({len(fails)} failures, {len(t.E)} entries checked)")
    return 1 if fails else 0


# ---------------------------------------------------------------- calling skills
def norm(q):
    q = q.strip().lower().lstrip("/").strip().strip("`'\"")
    return re.sub(r"[\s_]+", "-", q)


def toks(s):
    out = []
    for w in re.findall(r"[a-z0-9]+", s.lower()):
        if w in STOP:
            continue
        for suf in ("ing", "ers", "er", "es", "s"):
            if len(w) > 4 and w.endswith(suf):
                w = w[: -len(suf)]
                break
        out.append(w)
    return out


def rank_local(t, query, pool=None, limit=5):
    pool = [n for n in (pool or t.E) if not t.E[n].get("dead") and not t.E[n].get("retired") and not t.E[n].get("merged_into")]
    qt = toks(query)
    if not qt:
        return []
    docs = {}
    for n in pool:
        e = t.E[n]
        docs[n] = toks(n.replace("-", " ")) * 3 + toks(e.get("purpose", "")) + toks(e["meta"].replace("-", " "))
    N = len(docs) or 1
    df = {}
    for d in docs.values():
        for w in set(d):
            df[w] = df.get(w, 0) + 1
    avg = sum(len(d) for d in docs.values()) / N
    scores = []
    for n, d in docs.items():
        s, name_t = 0.0, toks(n.replace("-", " "))
        for w in qt:
            tf = d.count(w)
            if not tf and any(len(w) >= 3 and (x.startswith(w) or w.startswith(x)) and len(x) >= 3 for x in name_t):
                tf = 2
            if tf:
                idf = math.log(1 + (N - df.get(w, 0) + 0.5) / (df.get(w, 0) + 0.5))
                s += idf * tf * 2.2 / (tf + 1.2 * (0.25 + 0.75 * len(d) / avg))
        if s > 0:
            scores.append((s + 0.001 * math.log(1 + t.E[n].get("uses", 0)), n))
    return [n for _, n in sorted(scores, reverse=True)[:limit]]


def rank_metas(t, task, opts, criteria):
    """Deterministic meta ranking for the local fallback shortlist (no model)."""
    docs = {}
    for mm in opts:
        d = toks(mm.replace("-", " ")) * 3 + toks(criteria.get(mm, "")) * 2 + toks(t.info(mm)[0]) * 2
        for n, e in t.E.items():
            if e["meta"] == mm and n != mm and not e.get("dead") and not e.get("retired"):
                d += toks(n.replace("-", " ")) + toks(e.get("purpose", ""))
        docs[mm] = d
    N = len(docs) or 1
    df = {}
    for d in docs.values():
        for w in set(d):
            df[w] = df.get(w, 0) + 1
    avg = sum(len(d) for d in docs.values()) / N or 1
    qt = toks(task)
    sc = {}
    for mm, d in docs.items():
        s = 0.0
        for w in qt:
            tf = d.count(w)
            if tf:
                idf = math.log(1 + (N - df[w] + 0.5) / (df[w] + 0.5))
                s += idf * tf * 2.2 / (tf + 1.2 * (0.25 + 0.75 * len(d) / avg))
        sc[mm] = s
    return sorted(opts, key=lambda mm: (-sc[mm], -t.E.get(mm, {}).get("uses", 0)))


def resolve(t, q):
    names = set(t.E)
    raw = q.strip().lstrip("/")
    if raw in names:
        return raw, []
    k = norm(q)
    for cand in (k, re.split(r"[/>]+", k)[-1].strip("-"), re.sub(r"-?skills?$", "", k)):
        if cand in names:
            return cand, []
    comp = {n.replace("-", ""): n for n in names}
    if k.replace("-", "") in comp:
        return comp[k.replace("-", "")], []
    close = difflib.get_close_matches(k, sorted(names), n=5, cutoff=0.78)
    if len(close) == 1:
        return close[0], []
    qt = [w for w in k.split("-") if w]
    pref = [n for n in names if qt and all(any(p.startswith(w) or w.startswith(p) for p in n.split("-") if len(p) >= 3)
                                           for w in qt if len(w) >= 3)]
    if len(pref) == 1:
        return pref[0], []
    return None, close or sorted(pref)[:5] or rank_local(t, q.replace("-", " "))


def cmd_where(args):
    m = load()
    t = Tree(m)
    code = 0
    for q in args or []:
        n, sugg = resolve(t, q)
        if not n:
            print(f"not found: {q!r}. Closest: {', '.join(sugg) or 'none'}")
            code = 1
            continue
        if t.E[n]["role"] == "meta":
            print(read(os.path.join(LAYERS, n + ".md")).split("\n## ")[0].rstrip())
            print(f"Load: {t.dir(n)}/SKILL.md")
            print("Children: " + (", ".join(t.kids.get(n, [])) or "none"))
        else:
            print(read(os.path.join(NAV, n + ".md")).rstrip())
        print()
    return code


def cmd_find(words, limit=8):
    t = Tree(load())
    hits = rank_local(t, " ".join(words), limit=limit)
    if not hits:
        print("no local match")
        return 1
    for n in hits:
        e = t.E[n]
        print(f"{' > '.join(t.crumbs(n)):<70} {e.get('purpose', '')[:110]}")
    return 0


def route_bar(m, router, level, default=0.9):
    """PASS bar for one routing level. Uses the calibrated threshold from independent Jev-family labels
    (skill-surface-label report --write) only when it rests on 100+ labels and 50+ passes; else 0.90."""
    try:
        c = (((m.get("route_calibration") or {}).get("by_router") or {}).get(router) or {}).get(str(level)) or {}
        t = c.get("threshold")
        if t is not None and c.get("n_labeled", 0) >= 100 and c.get("n_pass", 0) >= 50:
            return round(float(t), 4)
    except Exception:
        pass
    return default


def jev_choice(q, instructions, criteria, task, subject, bar=0.9):
    sys.path.insert(0, RIGCAP)
    from rig_capabilities import s1gate
    from rig_capabilities.s1gate import DecisionLog, Rubric, evaluate
    if s1gate.JEV_ENDPOINT != "https://api.typesafe.ai/v1/systemone":
        return {"ok": False, "error": "skill-surface requires the hosted JEV API endpoint"}
    rb = Rubric(name=f"skill-surface.{q}", stage="routing", lane="skill-surface", description=instructions,
                questions={q: {"type": "choice", "instructions": instructions, "criteria": criteria}},
                rules=[{"when": f"{q}.confidence <= {bar:.4f}", "verdict": "ESCALATE",
                        "reason": f"confidence at or below {bar:.2f}"
                                  + (" (calibrated bar)" if bar != 0.9 else "") + ": judgment or Mike decides"}])
    log = DecisionLog()
    try:
        r = evaluate(rb, task, subject=subject, log=log, model="jev-latest")
    finally:
        log.close()
    if r.error:
        return {"ok": False, "error": r.error, "decision_id": r.decision_id}
    a = r.answers.get(q) or {}
    conf = a.get("confidence")
    probs = a.get("probabilities") or {}
    if (a.get("choice") not in criteria or not isinstance(conf, (int, float))
            or isinstance(conf, bool) or not math.isfinite(conf) or not 0 <= conf <= 1
            or not isinstance(probs, dict)
            or any(not isinstance(p, (int, float)) or isinstance(p, bool)
                   or not math.isfinite(p) or not 0 <= p <= 1 for p in probs.values())):
        return {"ok": False, "error": "invalid hosted JEV choice response", "decision_id": r.decision_id}
    return {"ok": True, "lane": "jev", "choice": a.get("choice"), "confidence": a.get("confidence"),
            "probs": a.get("probabilities") or {}, "verdict": r.verdict, "decision_id": r.decision_id,
            "model": r.model}
def redact_for_hosted(task):
    sens = bool(SENSITIVE.search(task))
    safe_task, privacy_error = None, None
    try:
        redacted = subprocess.run(
            [sys.executable, os.path.join(RIGCAP, "capabilities", "hooks", "redact_state.py")],
            input=task, capture_output=True, text=True, timeout=5, check=True).stdout
        sens = sens or redacted != task
        if SENSITIVE.search(redacted):
            privacy_error = "private details remain after secret redaction; hosted routing deferred"
        elif not redacted.strip():
            privacy_error = "redactor returned an empty task; hosted routing deferred"
        else:
            safe_task = redacted
    except (OSError, subprocess.SubprocessError):
        sens = True
        privacy_error = "secret redaction unavailable; hosted routing deferred"
    return safe_task, sens, privacy_error


def cmd_route(task, local=False, as_json=False):
    m = load()
    t = Tree(m)
    safe_task, sens, privacy_error = redact_for_hosted(task)
    why = privacy_error or ("hosted Jev with redacted task" if sens else "hosted Jev")
    if local:
        why += "; --local retired"
    sha = hashlib.sha256(task.encode()).hexdigest()
    levels = []

    def ask(level, q, instructions, criteria):
        if safe_task is None:
            levels.append({"level": level, "note": privacy_error})
            return None
        subject = f"skill-surface route L{level} sha256:{sha[:16]}"
        bar = route_bar(m, "hosted-jev", level)
        try:
            res = jev_choice(q, instructions, criteria, safe_task, subject, bar=bar)
        except Exception as ex:
            res = {"ok": False, "error": f"{type(ex).__name__}: {ex}"}
        if not res.get("ok"):
            levels.append({"level": level, "note": f"hosted Jev failed ({res.get('error')}); deferred",
                           "decision_id": res.get("decision_id")})
            return None
        res["bar"] = bar
        return res

    def top(res, k=3):
        return sorted(res["probs"].items(), key=lambda x: -x[1])[:k]

    status, load_n = "ROUTED", None
    crit1 = {mm: t.info(mm)[1] for mm in t.metas}
    crit1["other"] = "None of these areas fits the task"
    rule = next((mm for rx, mm in LANE_RULES if rx.search(task) and mm in t.metas), None)
    if rule:
        r1 = {"ok": True, "lane": "lane-rule", "choice": rule, "confidence": 1.0, "probs": {rule: 1.0},
              "verdict": "PASS", "decision_id": None, "model": "code"}
    else:
        r1 = ask(1, "meta", "Which area of Mike's skills should handle this task", crit1)
    if not r1:
        status = "DEFERRED"
    else:
        levels.append({"level": 1, "kind": "meta", **{k: r1[k] for k in ("choice", "confidence", "verdict", "decision_id", "lane")}, "bar": r1.get("bar", 0.9),
                       "alternatives": top(r1)})
        meta = r1["choice"]
        if r1["verdict"] != "PASS" or meta not in t.metas:
            status = "ESCALATE"
        else:
            load_n = meta
            kids = [k for k in t.kids.get(meta, []) if not t.E[k].get("dead") and not t.E[k].get("retired") and not t.E[k].get("merged_into")]
            if kids:
                crit2 = {k: (t.E[k].get("purpose") or k)[:220] for k in kids}
                crit2[meta] = f"The task is broad or spans several of these skills: use {meta}'s own routing"
                r2 = ask(2, "skill", f"Which {meta} skill should handle this task", crit2)
                if not r2:
                    status = "DEFERRED"
                else:
                    levels.append({"level": 2, "kind": "skill", **{k: r2[k] for k in ("choice", "confidence", "verdict", "decision_id", "lane")}, "bar": r2.get("bar", 0.9),
                                   "alternatives": top(r2)})
                    sk = r2["choice"]
                    if r2["verdict"] != "PASS":
                        status = "ESCALATE"
                    elif sk in t.E and sk != meta:
                        load_n = sk
                        subs = [s for s in t.subs.get(sk, []) if not t.E[s].get("dead") and not t.E[s].get("retired") and not t.E[s].get("merged_into")]
                        if subs:
                            crit3 = {s: (t.E[s].get("purpose") or s)[:220] for s in subs}
                            crit3[sk] = f"{sk} itself covers the task; no narrower sub-skill is needed"
                            r3 = ask(3, "sub", f"Which part of {sk} fits this task", crit3)
                            if not r3:
                                status = "DEFERRED"
                            else:
                                levels.append({"level": 3, "kind": "sub", **{k: r3[k] for k in ("choice", "confidence", "verdict", "decision_id", "lane")}, "bar": r3.get("bar", 0.9),
                                               "alternatives": top(r3)})
                                if r3["verdict"] != "PASS":
                                    status = "ESCALATE"
                                elif r3["choice"] in t.E and r3["choice"] != sk:
                                    load_n = r3["choice"]
    local_pick = rank_local(t, task, limit=5) if status != "ROUTED" else []
    rec = {"ts": now(), "source": os.environ.get("SKILL_SURFACE_SOURCE", "live"), "task_sha256": sha,
           "sensitive": sens, "lane_reason": why, "status": status,
           "levels": levels, "load": load_n, "local_candidates": local_pick}
    if not sens:
        rec["task_preview"] = task[:160]
    with open(ROUTES, "a") as f:
        f.write(json.dumps(rec) + "\n")
    if as_json:
        rec["load_path"] = t.E[load_n].get("load") if load_n else None
        rec["gates"] = t.info(t.E[load_n]["meta"])[2] if load_n else None
        print(json.dumps(rec, indent=1))
        return 0 if status == "ROUTED" else 2
    print(f"ROUTE  ({why})")
    for L in levels:
        if "choice" not in L:
            print(f"  L{L['level']} {L['note']}")
            continue
        alts = ", ".join(f"{a} {p:.2f}" for a, p in L["alternatives"][1:])
        did = f"decision {L['decision_id']}" if L.get("decision_id") else L.get("lane")
        conf = L.get("confidence")
        print(f"  L{L['level']} {L['kind']:<5} {L['choice']:<38} {conf if conf is None else f'{conf:.2f}':>5}  "
              f"{L['verdict']:<8} {did}" + (f"  bar {L['bar']:.2f} calibrated" if L.get("bar", 0.9) != 0.9 else "")
              + (f"   (also: {alts})" if alts and L["verdict"] != "PASS" else ""))
    if load_n:
        e = t.E[load_n]
        print(f"LOAD   {e.get('load')}")
        print(f"FIRST  {t.info(e['meta'])[2]} Gates: {t.dir(e['meta'])}/SKILL.md")
    if status == "ESCALATE":
        print("NEXT   the last level is ESCALATE: pick from the listed candidates with judgment, or ask Mike."
              + ("" if load_n else " No level passed, so nothing is loaded yet."))
    if status == "DEFERRED":
        print("DEFERRED  no classifier answered; local ranking only (not a verdict): " + ", ".join(local_pick))
    return 0 if status == "ROUTED" else 2


def cmd_tree(meta=None):
    txt = read(os.path.join(LIB, "TREE.md"))
    if not meta:
        print(txt)
        return 0
    mm = re.search(r"^### \d+\. " + re.escape(meta) + r"\n(.*?)(?=^### |\Z)", txt, re.S | re.M)
    print(mm.group(0) if mm else f"no meta {meta!r}")
    return 0 if mm else 1


# ---------------------------------------------------------------- maintenance
def cmd_status():
    m = load()
    vis = [n for n in os.listdir(USER) if not n.startswith(".")]
    hidden = [n for n in os.listdir(LIB) if not n.startswith(("_", ".")) and
              (os.path.isdir(os.path.join(LIB, n)) or os.path.islink(os.path.join(LIB, n)))]
    s = strays(m)
    missing = [x for x in m["metas"] if x not in vis]
    navs = len([f for f in os.listdir(NAV) if f.endswith(".md")]) if os.path.isdir(NAV) else 0
    print(f"visible user skills: {len(vis)} (target {len(m['metas'])})")
    print(f"hidden in library:   {len(hidden)}  (nav cards: {navs})")
    print(f"metas missing:       {missing or 'none'}")
    print(f"strays:              {[n for n, _ in s] or 'none'}")
    return 0 if len(vis) == len(m["metas"]) and not s and not missing else 1


def cmd_enforce(apply):
    m = load()
    s = strays(m)
    if not s:
        print("clean: nothing to move")
        return 0
    ts = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    home = "when-nothing-else-fits" if "when-nothing-else-fits" in m["metas"] else m["metas"][0]
    for n, src in s:
        dst = os.path.join(LIB, n)
        if os.path.lexists(dst):
            park = os.path.join(BK, "replaced", f"{n}-{ts}")
            print(f"{'REINSTALL' if apply else 'would reinstall'} {n}: library copy parked at {park}, new copy moved in")
            if apply:
                os.makedirs(os.path.dirname(park), exist_ok=True)
                shutil.move(dst, park)
                shutil.move(src, dst)
                m["entries"].setdefault(n, {"meta": home, "parent": None, "role": "skill",
                                            "from": src, "to": dst, "uses": 0})["reinstalled"] = ts
                bkp = os.path.join(BK, "build", n)
                if os.path.isdir(bkp):
                    shutil.rmtree(bkp)
        else:
            print(f"{'MOVE' if apply else 'would move'} {src} -> {dst} (filed under when-nothing-else-fits; re-home with `skill-surface file`)")
            if apply:
                shutil.move(src, dst)
                m["entries"][n] = {"meta": home, "parent": None, "role": "skill",
                                   "from": src, "to": dst, "uses": 0, "auto_filed": ts}
    if apply:
        save(m)
        build(quiet=True)
        print("rebuilt maps")
    return 0


def cmd_file(name, meta, parent, apply):
    m = load()
    t = Tree(m)
    new_entry = False
    if name not in t.E:
        sk_ = os.path.join(LIB, name, "SKILL.md")
        if not os.path.isfile(sk_):
            print(f"not a hidden skill: {name} (no manifest entry and no {sk_})")
            return 3
        new_entry = True
    elif t.E[name]["role"] == "meta":
        print(f"not a hidden skill: {name} (it is a layer-1 meta)")
        return 3
    if meta not in t.metas:
        print(f"unknown meta: {meta}")
        return 3
    if parent in (None, "none", ""):
        parent = None
    elif parent not in t.E or t.E[parent]["role"] != "skill" or t.E[parent]["meta"] != meta or parent == name:
        print(f"parent must be a layer-2 skill under {meta}: {parent}")
        return 3
    if parent and t.subs.get(name):
        print(f"{name} has sub-skills of its own; re-home them first: {', '.join(t.subs[name])}")
        return 3
    if new_entry:
        print(f"{'registered' if apply else 'would register'} {name}: (unregistered) -> {meta}/{parent}")
        if apply:
            m["entries"][name] = {"meta": meta, "parent": parent, "role": "sub" if parent else "skill",
                                  "uses": 0, "dead": False, "tested": False, "filed": now()}
            save(m)
            build(quiet=True)
        return 0
    e = t.E[name]
    print(f"{'filed' if apply else 'would file'} {name}: {e['meta']}/{e.get('parent')} -> {meta}/{parent}")
    if apply:
        e.update({"meta": meta, "parent": parent, "role": "sub" if parent else "skill"})
        e.pop("auto_filed", None)
        for s in t.subs.get(name, []):
            m["entries"][s]["meta"] = meta
        save(m)
        build(quiet=True)
    return 0


def cmd_restore(apply):
    m = load()
    E = m["entries"]
    steps = []
    bb = os.path.join(BK, "build")
    nb = [n for n in os.listdir(bb)] if os.path.isdir(bb) else []
    steps.append(f"restore {len(nb)} library SKILL.md files from build backups (removes position blocks)")
    if apply:
        for n in nb:
            src, dst = os.path.join(bb, n, "SKILL.md"), os.path.join(LIB, n, "SKILL.md")
            if os.path.isfile(src) and os.path.isfile(dst) and not is_foreign(os.path.join(LIB, n)):
                shutil.copy2(src, dst)
    back = [(n, e) for n, e in E.items() if e["role"] != "meta" and os.path.lexists(e["to"]) and not os.path.lexists(e["from"])]
    steps.append(f"move {len(back)} skills back to skills/user and leave a compat link at each library path")
    if apply:
        for n, e in back:
            shutil.move(e["to"], e["from"])
            os.symlink(e["from"], e["to"])
    fb = os.path.join(BK, "files")
    nf = sum(len(fs) for _, _, fs in os.walk(fb)) if os.path.isdir(fb) else 0
    steps.append(f"restore {nf} rewritten files from pass-1 backups")
    if apply:
        for d, _, fs in os.walk(fb):
            for f in fs:
                b = os.path.join(d, f)
                orig = b[len(fb):]
                if os.path.realpath(orig) != os.path.abspath(orig):
                    print(f"skip (resolves into another store, never overwrite): {orig}")
                    continue
                os.makedirs(os.path.dirname(orig), exist_ok=True)
                shutil.copy2(b, orig)
    steps.append("remove LAYERS.md from the real meta folders and the SKILL_SURFACE block from AGENTS.md")
    if apply:
        for mm in m["metas"]:
            p = os.path.join(USER, mm, "LAYERS.md")
            if not os.path.islink(os.path.join(USER, mm)) and os.path.exists(p):
                os.remove(p)
        a = read(AGENTS)
        a2 = re.sub(r"<!-- SKILL_SURFACE:BEGIN -->.*?<!-- SKILL_SURFACE:END -->\n*", "", a, flags=re.S)
        if a2 != a:
            write_if_changed(AGENTS, a2)
    steps.append(f"routines: re-point by hand from {BK}/routines-before.json (the compat links keep them working meanwhile)")
    for s in steps:
        print(("done: " if apply else "would ") + s)
    if not apply:
        print("dry run; add --apply to execute")
    return 0


USED_RE = re.compile(r"skills/(?:user|builtin(?:/site-specific)?)/([a-z0-9_.-]+)/SKILL\.md|skill-library/([a-z0-9_.-]+)/SKILL\.md")


def cmd_usage(refresh):
    """Recount, per skill, the chats in which an agent itself opened or named its SKILL.md
    (assistant turns only, so printed maps and tool output do not inflate the count)."""
    m = load()
    E = m["entries"]
    sess = os.path.join(ASIDE, "sessions")
    counts = {}
    for d in os.listdir(sess):
        f = os.path.join(sess, d, "messages.jsonl")
        if not os.path.isfile(f):
            continue
        seen = set()
        with open(f, errors="replace") as fh:
            for line in fh:
                if "SKILL.md" not in line or '"role":"assistant"' not in line.replace(" ", ""):
                    continue
                for a, b in USED_RE.findall(line):
                    seen.add(a or b)
        for n in seen:
            counts[n] = counts.get(n, 0) + 1
    diffs = sorted(((n, E[n].get("uses", 0), counts.get(n, 0)) for n in E if counts.get(n, 0) != E[n].get("uses", 0)),
                   key=lambda x: -abs(x[2] - x[1]))
    print(f"chats scanned: {len(os.listdir(sess))} | skills whose count changed: {len(diffs)}")
    for n, old, new in diffs[:12]:
        print(f"  {n:<36} {old:>4} -> {new}")
    if refresh:
        for n, _, new in diffs:
            E[n]["uses"] = new
        m["usage_counted"] = now()
        m["usage_chats"] = len(os.listdir(sess))
        m["usage_method"] = "chats where an assistant turn opened or named the skill's SKILL.md"
        save(m)
        build(quiet=True)
        print("manifest updated and maps rebuilt")
    return 0


def cmd_misses(days=7, write=False):
    """Routes that did not land (ESCALATE / DEFERRED) in the last N days, live traffic only, grouped
    by where Jev leaned. Written for jake-scout: each group is a candidate for a sharper skill or
    description. Private tasks are counted, never quoted."""
    if not os.path.exists(ROUTES):
        print("no routes logged yet")
        return 0
    label_shas = set()
    ls = os.path.join(LIB, "_label-set.jsonl")
    if os.path.exists(ls):
        for line in open(ls):
            try:
                it = json.loads(line)
                label_shas.add(hashlib.sha256((it.get("text") or it.get("title") or "").encode()).hexdigest())
            except Exception:
                pass
    cutoff = (datetime.datetime.now() - datetime.timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%S")
    rows = []
    for line in open(ROUTES):
        try:
            r = json.loads(line)
        except Exception:
            continue
        if r.get("ts", "") < cutoff or r.get("source", "live") != "live" or r.get("task_sha256") in label_shas:
            continue
        rows.append(r)
    miss = [r for r in rows if r.get("status") != "ROUTED"]
    groups = {}
    for r in miss:
        lv = [L for L in r.get("levels", []) if "choice" in L]
        key = " > ".join(L["choice"] for L in lv) if lv else "(no level answered)"
        groups.setdefault(key, []).append(r)
    lines = [f"# Skill-surface misses, last {days} days ({now()})", "",
             f"Live routes: {len(rows)} | landed: {len(rows) - len(miss)} | missed: {len(miss)}", "",
             "Each group is where Jev leaned before it stopped. Recurring groups are jake-scout candidates: a sharper",
             "description (GEPA), a missing child skill, or a meta that should own the work.", ""]
    for key, rs in sorted(groups.items(), key=lambda kv: -len(kv[1])):
        lines.append(f"## {len(rs)}x  {key}")
        for r in rs[:5]:
            lines.append("- " + (r.get("task_preview") or "(private task: not quoted)")[:140])
        lines.append("")
    text = "\n".join(lines) + "\n"
    print(text if not write else f"{len(miss)} misses in {len(groups)} groups")
    if write:
        p = os.path.join(LIB, f"_misses-{datetime.date.today().isoformat()}.md")
        write_if_changed(p, text)
        print(f"written: {p}")
    return 0


def cmd_eval(include_sensitive=False):
    """Run the saved routing evals; exit 1 if meta accuracy drops below 0.85."""
    cases = json.load(open(os.path.join(LIB, "_route-evals.json")))
    n = ok_meta = ok_skill = n_skill = passed = on_skill = 0
    for c in cases:
        if c.get("sensitive") and not include_sensitive:
            continue
        p = subprocess.run([sys.executable, os.path.abspath(__file__), "route", c["task"], "--json"],
                           capture_output=True, text=True, timeout=300,
                           env={**os.environ, "SKILL_SURFACE_SOURCE": "eval"})
        try:
            r = json.loads(p.stdout)
        except Exception:
            print(f"ERROR  {c['task'][:60]}: {p.stderr[-200:]}")
            n += 1
            continue
        lv = {L["level"]: L for L in r["levels"] if "choice" in L}
        meta = lv.get(1, {}).get("choice")
        skill = lv.get(2, {}).get("choice")
        n += 1
        mo = meta in c["meta"]
        ok_meta += mo
        passed += r["status"] == "ROUTED"
        on_skill += bool(r.get("load")) and r.get("load") not in c["meta"] and r.get("load") != meta
        so = None
        if c.get("skill"):
            n_skill += 1
            so = skill in c["skill"] or (skill is None and meta in c["skill"])
            ok_skill += bool(so)
        print(f"{'ok ' if mo else 'MISS'} {'' if so is None else ('ok ' if so else 'MISS')} {r['status']:<9} "
              f"{str(meta):<30} {str(skill):<28} {c['task'][:52]}")
    acc = ok_meta / n if n else 0
    print(f"meta top-choice accuracy {ok_meta}/{n} = {acc:.2f} | skill accuracy {ok_skill}/{n_skill} | "
          f"loaded a specific skill (layer 2-3) {on_skill}/{n} | every level PASS {passed}/{n}")
    return 0 if acc >= 0.85 else 1


def cmd_export(out):
    """Portable tree (no machine paths) for the canonical repo: name -> layer, meta, parent, status."""
    m = load()
    t = refresh(m)
    tree = {"metas": [{"name": mm, "rank": t.rank[mm], "blurb": t.info(mm)[0], "route": t.info(mm)[1],
                       "gate": t.info(mm)[2], "owner": OWNERS.get(mm)} for mm in t.ranked],
            "librarian": LIBRARIAN,
            "skills": {n: {k: v for k, v in {"layer": t.layer(n), "meta": e["meta"], "parent": e.get("parent"),
                                             "merged_into": e.get("merged_into"), "retired": bool(e.get("retired")),
                                             "dead": bool(e.get("dead")), "tested": bool(e.get("tested"))}.items() if v not in (None, False)}
                       for n, e in sorted(t.E.items())},
            "lane_rules": [[rx.pattern, mm] for rx, mm in LANE_RULES]}
    write_if_changed(out, json.dumps(tree, indent=1).replace(HOME, "~") + "\n")
    print(f"exported {len(tree['skills'])} skills under {len(tree['metas'])} metas -> {out}")
    return 0


# Other harnesses get the same 30-meta menu through their own native switches; no skill folder moves.
HARNESS = {
    "claude": {"root": f"{HOME}/.claude/skills", "commands": f"{HOME}/.claude/commands",
               "settings": f"{HOME}/.claude/settings.json", "mode": "claude", "pointer": f"{HOME}/.claude/CLAUDE.md"},
    "codex": {"root": f"{HOME}/.codex/skills", "mode": "codex", "pointer": f"{HOME}/.codex/AGENTS.md"},
    "agents": {"root": f"{HOME}/.agents/skills", "mode": "codex", "pointer": None},
    "omp": {"root": None, "config": f"{HOME}/.omp/agent/config.yml", "mode": "omp", "pointer": f"{HOME}/.omp/agent/AGENTS.md"},
}
HB, HE = "<!-- SKILL_SURFACE:BEGIN -->", "<!-- SKILL_SURFACE:END -->"
CODEX_POLICY = "policy:\n  allow_implicit_invocation: false\n"


def harness_pointer(name):
    return (f"{HB}\n## Skill routing: 30 meta-skills (skill surface, 2026-09-29)\n"
            f"Only Mike's 30 meta-skills are listed to you; every other skill in this harness stays callable by name "
            f"({'`/name`' if name == 'claude' else '`$name`'}) and every hidden skill has a nav card at "
            f"`{NAV}/<name>.md`. Picking a skill for a described task is a typed judgment: run "
            f"`{SELF} route \"<task>\"` (one Jev choice per layer, logged decision ids) before reading the catalog; "
            f"if no classifier answers the verdict is DEFERRED, so use `{SELF} find \"<words>\"`. "
            f"{HOSTED_POLICY} Resolve a name with `{SELF} where <name>`. "
            f"Obey the meta's gates before any outward step.\n{HE}\n")


def pointer_add(cur, blk):
    """Append our block after the file's own bytes (kept verbatim), or refresh it in place."""
    if HB in cur:
        return re.sub(re.escape(HB) + r".*?" + re.escape(HE) + r"\n?", lambda _m: blk, cur, flags=re.S)
    if not cur:
        return blk
    return cur + ("" if cur.endswith("\n") else "\n") + "\n" + blk


def pointer_remove(cur, backup=None):
    """Drop our block; when the rest equals the pre-change backup, return the backup's exact bytes."""
    out = re.sub(r"\n?" + re.escape(HB) + r".*?" + re.escape(HE) + r"\n?", "", cur, flags=re.S)
    if backup and os.path.exists(backup):
        orig = read(backup)
        if out.rstrip("\n") == orig.rstrip("\n"):
            return orig
    return out


def omp_pointer(t):
    rows = "\n".join(f"- `{mm}`: {t.info(mm)[0]}" for mm in t.ranked)
    return (f"{HB}\n## Skill menu: 30 meta-skills (skill surface, 2026-09-29)\n"
            f"OMP's skill listing is off (`skillful: false`); this is the menu. Every loaded skill is still addressable as "
            f"`skill://<name>`, so a named skill loads exactly as before. For a described task, pick the meta below "
            f"that owns it and read `skill://<meta>`; it names its skills and sub-skills. Picking a skill for a task is "
            f"a typed judgment: run `{SELF} route \"<task>\"` (one Jev choice per layer, logged decision ids) before a "
            f"frontier model reads any catalog; if no classifier answers, the verdict is DEFERRED, so use "
            f"`{SELF} find \"<words>\"`. {HOSTED_POLICY} "
            f"A skill OMP does not load: `{SELF} where <name>` prints its SKILL.md path; read "
            f"that file. `/skillful` turns the full listing back on for one session.\n{rows}\n{HE}\n")


def aside_pointer(t):
    """Render Aside's prompt pointer without expanding layer-2 or layer-3 skills."""
    rows = "\n".join(f"- `{mm}`: {t.info(mm)[0]}" for mm in t.ranked)
    return (f"{HB}\n## Skill menu: {len(t.metas)} meta-skills (skill surface)\n"
            f"Only Mike's meta-skills are listed here; every hidden skill remains callable by name and has a nav card at "
            f"`{NAV}/<name>.md`. For a described task, run `{SELF} route \"<task>\"` before reading the catalog; "
            f"if no classifier answers, use `{SELF} find \"<words>\"`. {HOSTED_POLICY} "
            f"Resolve a name with `{SELF} where <name>` and obey the selected meta's gates.\n{rows}\n{HE}\n")


def harness_omp(apply=False, restore=False):
    """OMP 18: no per-skill hide in settings, but `skillful: false` drops the listing while every loaded skill
    stays addressable as skill://<name>. Also makes sure all metas are in its includeSkills allowlist.
    Surgical text edits so concurrent writers to config.yml keep their changes; restore undoes only ours."""
    import fnmatch
    h, m = HARNESS["omp"], load()
    t = refresh(m)
    cfg, ptr = h["config"], h["pointer"]
    sp = os.path.join(LIB, "_harness", "omp.json")
    st = json.load(open(sp)) if os.path.exists(sp) else {"added": [], "skillful_prev": "absent", "applied": False}
    if not os.path.exists(cfg):
        print(f"no OMP config at {cfg}")
        return 3
    txt = read(cfg)
    blk = re.search(r"^  includeSkills:\n((?:    - .*\n)*)", txt, re.M)
    sk = re.search(r"^skillful:[ \t]*(\S+)[ \t]*$", txt, re.M)
    if restore:
        new = txt
        if blk and st["added"]:
            keep = [l for l in blk.group(1).splitlines(True)
                    if l.strip()[2:].strip().strip("'\"") not in set(st["added"])]
            new = new[:blk.start(1)] + "".join(keep) + new[blk.end(1):]
        for d in st.get("added_dirs", []):
            cdb = re.search(r"^  customDirectories:\n((?:    - .*\n)*)", new, re.M)
            if cdb:
                keep = [l for l in cdb.group(1).splitlines(True) if l.strip()[2:].strip().strip("'\"") != d]
                new = new[:cdb.start(1)] + "".join(keep) + new[cdb.end(1):]
        if st.get("applied"):
            if st["skillful_prev"] == "absent":
                new = re.sub(r"^skillful:[ \t]*false[ \t]*\n?", "", new, count=1, flags=re.M)
            else:
                new = re.sub(r"^skillful:[ \t]*\S+", f"skillful: {st['skillful_prev']}", new, count=1, flags=re.M)
        if apply:
            if new != txt:
                write_if_changed(cfg, new)
            if os.path.exists(ptr):
                write_if_changed(ptr, pointer_remove(read(ptr), os.path.join(LIB, "_harness", "backup", "omp", os.path.basename(ptr))))
            if os.path.exists(sp):
                os.remove(sp)
        print(f"{'restored' if apply else 'would restore'} omp: remove {len(st['added'])} allowlist lines, "
              f"skillful back to {st['skillful_prev']}, pointer removed")
        return 0
    add = []
    if blk:
        pats = [l.strip()[2:].strip().strip("'\"") for l in blk.group(1).splitlines() if l.strip()]
        add = [mm for mm in t.ranked if not any(fnmatch.fnmatchcase(mm, g) for g in pats)]
    new = txt
    if add and blk:
        new = new[:blk.end(1)] + "".join(f"    - {mm}\n" for mm in add) + new[blk.end(1):]
    # the metas live as real folders in the Aside menu dir; OMP skips the ~/.agents symlinks to them
    cdb = re.search(r"^  customDirectories:\n((?:    - .*\n)*)", new, re.M)
    add_dirs = []
    if cdb and USER not in [l.strip()[2:].strip().strip("'\"") for l in cdb.group(1).splitlines()]:
        add_dirs = [USER]
        new = new[:cdb.end(1)] + f"    - {USER}\n" + new[cdb.end(1):]
    prev = sk.group(1) if sk else "absent"
    if sk:
        if sk.group(1) == "true" and st.get("applied"):
            print("note: skillful was set back to true after our change; left alone (someone chose the full listing)")
        elif sk.group(1) != "false":
            new = re.sub(r"^skillful:[ \t]*\S+", "skillful: false", new, count=1, flags=re.M)
    else:
        new = new.rstrip("\n") + "\nskillful: false\n"
    cur = read(ptr) if os.path.exists(ptr) else ""
    blk_txt = omp_pointer(t)
    pnew = pointer_add(cur, blk_txt)
    if apply:
        bdir = os.path.join(LIB, "_harness", "backup", "omp")
        os.makedirs(bdir, exist_ok=True)
        for f in (cfg, ptr):
            b = os.path.join(bdir, os.path.basename(f))
            if os.path.exists(f) and not os.path.exists(b):
                shutil.copy2(f, b)
        if read(cfg) != txt:  # another writer changed it between our read and now: redo from the fresh text
            print("omp config changed underneath us; rerun")
            return 4
        if new != txt:
            write_if_changed(cfg, new)
        if pnew != cur:
            write_if_changed(ptr, pnew)
        if not st.get("applied"):
            st["skillful_prev"] = prev
        st["added"] = sorted(set(st["added"]) | set(add))
        st["added_dirs"] = sorted(set(st.get("added_dirs", [])) | set(add_dirs))
        st["applied"] = True
        os.makedirs(os.path.dirname(sp), exist_ok=True)
        with open(sp, "w") as fh:
            json.dump(st, fh, indent=1)
    print(f"{'applied' if apply else 'would apply'} omp: add {len(add_dirs)} skill folder(s) to customDirectories, "
          f"add {len(add)} metas to includeSkills "
          f"({', '.join(add) or 'none'}), skillful {prev} -> false, pointer {'updated' if pnew != cur else 'unchanged'}")
    return 0


def cmd_harness(name, apply=False, restore=False):
    if name not in HARNESS:
        print(f"unknown harness {name}; one of {', '.join(HARNESS)}")
        return 3
    if name == "omp":
        return harness_omp(apply=apply, restore=restore)
    h, m = HARNESS[name], load()
    metas, root = m["metas"], h["root"]
    sp = os.path.join(LIB, "_harness", f"{name}.json")
    st = json.load(open(sp)) if os.path.exists(sp) else {"links": [], "created": [], "modified": {}, "overrides": []}
    bdir = os.path.join(LIB, "_harness", "backup", name)
    if restore:
        n = 0
        for f in st["created"]:
            if os.path.exists(f):
                n += 1
                if apply:
                    os.remove(f)
                    d = os.path.dirname(f)
                    if os.path.isdir(d) and not os.listdir(d):
                        os.rmdir(d)
        for f, b in st["modified"].items():
            if apply and os.path.exists(b):
                shutil.copy2(b, f)
        for l in st["links"]:
            if apply and os.path.islink(l):
                os.remove(l)
        if h["mode"] == "claude" and st["overrides"] and h["settings"] not in st["modified"]:
            s = json.load(open(h["settings"]))
            ov = s.get("skillOverrides", {})
            for k in st["overrides"]:
                if ov.get(k) == "user-invocable-only":
                    ov.pop(k)
            if apply:
                s["skillOverrides"] = ov
                write_if_changed(h["settings"], json.dumps(s, indent=2) + "\n")
        if h["pointer"] and os.path.exists(h["pointer"]) and apply:
            write_if_changed(h["pointer"], pointer_remove(read(h["pointer"]), os.path.join(bdir, os.path.basename(h["pointer"]))))
        print(f"{'restored' if apply else 'would restore'} {name}: {n} files removed, {len(st['modified'])} files put back, "
              f"{len(st['links'])} meta links removed, {len(st['overrides'])} overrides cleared")
        if apply:
            os.remove(sp)
        return 0
    links, created, modified, hidden = [], [], {}, []
    for mm in metas:
        p = os.path.join(root, mm)
        if not os.path.lexists(p):
            links.append(p)
            if apply:
                os.symlink(os.path.join(USER, mm), p)
    if h["mode"] == "claude":
        names = [d for d in os.listdir(root) if not d.startswith(".") and d not in metas]
        cmds = [f[:-3] for f in os.listdir(h["commands"]) if f.endswith(".md")] if os.path.isdir(h["commands"]) else []
        s = json.load(open(h["settings"]))
        ov = s.get("skillOverrides", {})
        for n in sorted(set(names + cmds) - set(metas)):
            if n not in ov:
                ov[n] = "user-invocable-only"
                hidden.append(n)
        blocked = [mm for mm in metas if ov.get(mm) in ("off", "user-invocable-only")]
        if apply and hidden:
            b = os.path.join(bdir, "settings.json")
            if not os.path.exists(b):
                os.makedirs(bdir, exist_ok=True)
                shutil.copy2(h["settings"], b)
            modified.setdefault(h["settings"], b)
            s["skillOverrides"] = ov
            write_if_changed(h["settings"], json.dumps(s, indent=2) + "\n")
        if blocked:
            print(f"note: these metas are hidden by an existing override and were left alone: {', '.join(blocked)}")
    else:
        for d in sorted(os.listdir(root)):
            dp = os.path.join(root, d)
            if d.startswith(".") or d in metas or not os.path.isdir(dp):
                continue
            if os.path.islink(dp):
                continue
            y = os.path.join(dp, "agents", "openai.yaml")
            if not os.path.exists(y):
                created.append(y)
                hidden.append(d)
                if apply:
                    os.makedirs(os.path.dirname(y), exist_ok=True)
                    with open(y, "w") as fh:
                        fh.write(CODEX_POLICY)
                continue
            if os.path.islink(y):
                continue
            txt = read(y)
            if re.search(r"allow_implicit_invocation:\s*false", txt):
                continue
            if re.search(r"allow_implicit_invocation:", txt):
                new = re.sub(r"allow_implicit_invocation:\s*\S+", "allow_implicit_invocation: false", txt)
            elif re.search(r"^policy:\s*$", txt, re.M):
                new = re.sub(r"^policy:\s*$", "policy:\n  allow_implicit_invocation: false", txt, count=1, flags=re.M)
            else:
                new = txt.rstrip("\n") + "\n" + CODEX_POLICY
            hidden.append(d)
            if apply:
                b = os.path.join(bdir, d, "openai.yaml")
                os.makedirs(os.path.dirname(b), exist_ok=True)
                if not os.path.exists(b):
                    shutil.copy2(y, b)
                modified[y] = b
                write_if_changed(y, new)
    ptr_changed = False
    if h["pointer"]:
        cur = read(h["pointer"]) if os.path.exists(h["pointer"]) else ""
        blk = harness_pointer(name)
        new = pointer_add(cur, blk)
        ptr_changed = new != cur
        if apply and ptr_changed:
            b = os.path.join(bdir, os.path.basename(h["pointer"]))
            if cur and not os.path.exists(b):
                os.makedirs(bdir, exist_ok=True)
                shutil.copy2(h["pointer"], b)
            write_if_changed(h["pointer"], new)
    print(f"{'applied' if apply else 'would apply'} {name}: link {len(links)} missing metas, hide {len(hidden)} skills from the "
          f"model (still callable by name), pointer {'updated' if ptr_changed else 'unchanged'}")
    if apply:
        st["links"] = sorted(set(st["links"]) | set(links))
        st["created"] = sorted(set(st["created"]) | set(created))
        st["modified"].update(modified)
        if h["mode"] == "claude":
            st["overrides"] = sorted(set(st["overrides"]) | set(hidden))
        os.makedirs(os.path.dirname(sp), exist_ok=True)
        with open(sp, "w") as fh:
            json.dump(st, fh, indent=1)
    return 0


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = a[0], a[1:]
    flag = lambda f: f in rest
    args = [x for x in rest if not x.startswith("--")]
    if cmd == "status":
        return cmd_status()
    if cmd == "build":
        return build(dry=flag("--dry-run"))
    if cmd == "verify":
        return verify()
    if cmd == "where":
        return cmd_where(args)
    if cmd == "find":
        lim = int(rest[rest.index("--limit") + 1]) if "--limit" in rest else 8
        return cmd_find([x for x in args if x != str(lim)] if "--limit" in rest else args, lim)
    if cmd == "route":
        if not args:
            print('usage: skill-surface route "<task>" [--local] [--json]')
            return 3
        return cmd_route(" ".join(args), local=flag("--local"), as_json=flag("--json"))
    if cmd == "eval":
        return cmd_eval(include_sensitive=flag("--sensitive"))
    if cmd == "usage":
        return cmd_usage(flag("--refresh"))
    if cmd == "misses":
        d = int(rest[rest.index("--days") + 1]) if "--days" in rest else 7
        return cmd_misses(d, flag("--write"))
    if cmd == "harness":
        if not args:
            print("usage: skill-surface harness <claude|codex|agents> [--apply] [--restore]")
            return 3
        return cmd_harness(args[0], apply=flag("--apply"), restore=flag("--restore"))
    if cmd == "export":
        return cmd_export(args[0] if args else os.path.join(LIB, "_tree-export.json"))
    if cmd == "tree":
        return cmd_tree(args[0] if args else None)
    if cmd == "enforce":
        return cmd_enforce(flag("--apply"))
    if cmd == "file":
        meta = rest[rest.index("--meta") + 1] if "--meta" in rest else None
        par = rest[rest.index("--parent") + 1] if "--parent" in rest else None
        if not args or not meta:
            print("usage: skill-surface file <name> --meta <meta> [--parent <skill>|none] [--apply]")
            return 3
        return cmd_file(args[0], meta, par, flag("--apply"))
    if cmd == "restore":
        return cmd_restore(flag("--apply"))
    print(__doc__)
    return 3


if __name__ == "__main__":
    sys.exit(main())
