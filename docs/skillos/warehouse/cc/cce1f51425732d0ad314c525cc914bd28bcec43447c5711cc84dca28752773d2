harness_id: hB-06-twitter-thread
harness_name: Twitter/X Thread Session Harness
session_type: twitter-thread-session
doctrine_focus: content & marketing
library: needle-haystack-v0
batch: B
coordinate_space:
  levels:
  - L1
  - L2
  - L3
  - L4
  diamonds:
  - D1
  - D2
  - D3
  - D4
  - D5
