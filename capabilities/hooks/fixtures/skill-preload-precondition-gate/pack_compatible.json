{
  "task": {
    "id": "pack-compatible",
    "goal": "fix the flaky dependency build",
    "requirements": {
      "artifact-path": "build/",
      "output-format": ["json", "jsonl"],
      "budget-tokens": { "max": 4000 }
    },
    "counterparts": [{ "id": "rig-capabilities", "version": "2.4.1" }]
  },
  "state": {
    "repo_kind": "npm",
    "container_runtime": "docker",
    "python_version": "3.13.1",
    "installed": ["pytest", "ruff"]
  },
  "candidates": [
    {
      "id": "dependency-doctor",
      "version": "1.3.0",
      "activation": "a dependency-related build failure is detected",
      "applies_when": [
        { "field": "container_runtime", "exists": true },
        { "field": "python_version", "version_band": ">=3.9,<4" }
      ],
      "defaults": {
        "artifact-path": "build/reports/",
        "output-format": "json",
        "budget-tokens": 1800
      },
      "counterparts": [{ "id": "rig-capabilities", "version_band": ">=2.0,<3.0" }]
    },
    {
      "id": "npm-audit-triage",
      "version": "0.9.2",
      "activation": "an npm audit finding blocks the release lane",
      "applies_when": [
        { "field": "repo_kind", "equals": "npm" },
        { "field": "task.goal", "matches": "fix|ship" }
      ],
      "defaults": { "artifact-path": "build/", "output-format": "jsonl" },
      "counterparts": []
    }
  ]
}
