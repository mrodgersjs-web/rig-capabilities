#!/usr/bin/env python3
"""rig-s1gate -- RIG System-1 Gate CLI.

Exit codes are the contract. Hooks and CI read these, not stdout:
    0  PASS      -- gate cleared, proceed
    1  BLOCK     -- enforced stop (calibrated rubric, or provider failed closed)
    2  ESCALATE  -- hand to a System 2 model or a human
    3  usage/config error

Usage
-----
    rig-s1gate list
    rig-s1gate show <rubric>
    rig-s1gate check <rubric> [--file PATH | --text STR | -]   [--subject S] [--json]
    rig-s1gate label <decision-id> <good|bad> [--signal question.attr]
    rig-s1gate calibrate <rubric> --signal Q.ATTR [--direction above|below]
                                  [--max-false-block 0.05] [--min-recall 0.50] [--write]
    rig-s1gate stats [rubric]
    rig-s1gate cache-stats [rubric]     deterministic answer cache: entries, hits, ms saved
    rig-s1gate cache-clear [rubric|--all]  drop cached provider answers (rebuilds from live calls)
    rig-s1gate recent [rubric] [-n N] [--unlabelled]   list logged decisions for labelling
    rig-s1gate review <decision-id>                    show one decision: state preview, answers, reasons
    rig-s1gate selftest
    rig-s1gate improve <rubric> [--file PATH | --stdin] [--context STR] [--max 3]
                                [--accept PASS|ESCALATE] [--json]
    rig-s1gate rank <rubric> --file CANDIDATES   (candidates separated by a line '---')
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from rig_capabilities.s1gate import (  # noqa: E402
    BLOCK,
    ESCALATE,
    PASS,
    DecisionLog,
    S1GateError,
    evaluate,
    list_rubrics,
    load_rubric,
)
from rig_capabilities.s1gate_calibrate import calibrate_rubric, report  # noqa: E402
from rig_capabilities.s1gate_improve import improve, rank  # noqa: E402

EXIT = {PASS: 0, BLOCK: 1, ESCALATE: 2}


def _read_state(args) -> str:
    if args.text:
        return args.text
    if args.file == "-" or args.stdin:
        return sys.stdin.read()
    if args.file:
        return Path(args.file).read_text(encoding="utf-8")
    if not sys.stdin.isatty():
        return sys.stdin.read()
    raise SystemExit("s1gate: no input. Use --file, --text, or pipe to stdin.")


def cmd_list(args) -> int:
    names = list_rubrics()
    if not names:
        print("no rubrics found")
        return 3
    print("%-22s %-10s %-10s %-11s %s" % ("RUBRIC", "STAGE", "LANE", "MODE", "DESCRIPTION"))
    for n in names:
        try:
            rb = load_rubric(n)
        except S1GateError as exc:
            print("%-22s %s" % (n, exc))
            continue
        mode = "ENFORCING" if rb.enforcing else "advisory"
        if rb.never_auto:
            mode += "+never_auto"
        print("%-22s %-10s %-10s %-11s %s" % (n, rb.stage, rb.lane, mode, rb.description[:58]))
    return 0


def cmd_show(args) -> int:
    rb = load_rubric(args.rubric)
    print(json.dumps({
        "name": rb.name, "stage": rb.stage, "lane": rb.lane,
        "calibrated": rb.calibrated, "enforcing": rb.enforcing,
        "mode": "ENFORCING" if rb.enforcing else "advisory",
        "never_auto": rb.never_auto,
        "confidence_floor": rb.confidence_floor,
        "questions": list(rb.questions), "rules": rb.rules,
        "calibration": rb.calibration,
    }, indent=2))
    return 0


def _need_subject(args) -> int | None:
    """Exit-code contract: 3 = usage/config error. The decision log refuses
    unattributable rows, so refuse here before spending a live Jev call."""
    if args.subject is None or not str(args.subject).strip():
        print("rig-s1gate: --subject is required (kind:id@sha12, e.g. "
              "--subject code.diff:pr-42@a1b2c3d4e5f6)", file=sys.stderr)
        return 3
    return None


def cmd_check(args) -> int:
    bad = _need_subject(args)
    if bad is not None:
        return bad
    state = _read_state(args)
    log = DecisionLog()
    try:
        res = evaluate(args.rubric, state, subject=args.subject, log=log)
    finally:
        log.close()
    if args.json:
        print(json.dumps(res.to_dict(), indent=2))
    else:
        print(res.summary())
        if res.decision_id:
            print("  decision id %d  (%dms, %s)" % (res.decision_id, res.latency_ms, res.model))
            print("  label it later:  rig-s1gate label %d good|bad   (review it first: rig-s1gate review %d)" % (res.decision_id, res.decision_id))
    # An advisory verdict never hard-fails a build; it reports 2 at worst.
    code = EXIT[res.verdict]
    if res.advisory and code == 1:
        code = 2
    return code


def cmd_label(args) -> int:
    if args.label not in ("good", "bad"):
        raise SystemExit("label must be 'good' or 'bad'")
    log = DecisionLog()
    try:
        if args.signal:
            log.label_signal(args.decision_id, args.signal, args.label)
        else:
            log.label(args.decision_id, args.label)
    finally:
        log.close()
    print("decision %d labelled %s%s" % (
        args.decision_id, args.label, " for " + args.signal if args.signal else ""))
    return 0


def cmd_calibrate(args) -> int:
    if "." not in args.signal:
        raise SystemExit("--signal must look like question.attr, e.g. weakened_test.noul")
    q, attr = args.signal.split(".", 1)
    result = calibrate_rubric(
        args.rubric, (q, attr),
        direction=args.direction,
        max_false_block_rate=args.max_false_block,
        min_recall=args.min_recall,
        write=args.write,
    )
    print(report(result))
    return 0 if result["certified"] else 2


def cmd_stats(args) -> int:
    log = DecisionLog()
    try:
        counts = log.counts(args.rubric)
        hyg = log.hygiene(args.rubric)
    finally:
        log.close()
    if not counts:
        print("no decisions recorded yet")
        return 0
    total = sum(counts.values())
    scope = args.rubric or "ALL"
    print("s1gate decisions (%s, excluding quarantined rows): %d" % (scope, total))
    for v in (BLOCK, ESCALATE, PASS):
        if v in counts:
            print("  %-9s %5d  (%4.1f%%)" % (v, counts[v], 100.0 * counts[v] / total))
    print("corpus hygiene (%s): total %d  blank-subject %d  quarantined %d  clean %d"
          % (scope, hyg["total"], hyg["blank"], hyg["excluded"], hyg["clean"]))
    if hyg["clean"]:
        print("pass rate over clean rows: %d/%d (%.1f%%)"
              % (hyg["clean_pass"], hyg["clean"], 100.0 * hyg["clean_pass"] / hyg["clean"]))
    return 0


def cmd_cache_stats(args) -> int:
    log = DecisionLog()
    try:
        st = log.cache_stats(args.rubric)
    finally:
        log.close()
    if args.json:
        print(json.dumps(st, indent=2))
        return 0
    print("answer cache: %s  (ttl %.1f days)" % ("ENABLED" if st["enabled"] else "DISABLED", st["ttl_days"]))
    if not st["rubrics"]:
        print("  empty -- no provider answers cached yet")
        return 0
    print("  %-22s %8s %8s %10s" % ("RUBRIC", "ENTRIES", "HITS", "KB"))
    for r in st["rubrics"]:
        print("  %-22s %8d %8d %10.1f" % (r["rubric"], r["entries"], r["hits"], r["bytes"] / 1024.0))
    print("  logged cache hits: %d   est. provider latency avoided: %.1fs"
          % (st["logged_cache_hits"], st["est_ms_saved"] / 1000.0))
    return 0


def cmd_cache_clear(args) -> int:
    if not args.all and not args.rubric:
        raise SystemExit("cache-clear needs a rubric name or --all")
    log = DecisionLog()
    try:
        n = log.cache_clear(None if args.all else args.rubric)
    finally:
        log.close()
    print("dropped %d cached answer%s%s" % (n, "" if n == 1 else "s",
          " for " + args.rubric if args.rubric and not args.all else ""))
    return 0


def cmd_improve(args) -> int:
    bad = _need_subject(args)
    if bad is not None:
        return bad
    draft = _read_state(args)
    log = DecisionLog()
    try:
        res = improve(args.rubric, draft, context=args.context or "",
                      max_iterations=args.max, accept=args.accept,
                      subject=args.subject, log=log)
    finally:
        log.close()
    if args.json:
        print(json.dumps(res.to_dict(), indent=2))
    else:
        print(res.summary(), file=sys.stderr)
        print(res.best)
    return 0 if res.cleared else 2


def cmd_rank(args) -> int:
    bad = _need_subject(args)
    if bad is not None:
        return bad
    raw = Path(args.file).read_text(encoding="utf-8") if args.file != "-" else sys.stdin.read()
    cands = [c.strip() for c in raw.split("\n---\n") if c.strip()]
    if len(cands) < 2:
        raise SystemExit("rank needs at least 2 candidates separated by a line containing only ---")
    log = DecisionLog()
    try:
        rows = rank(args.rubric, cands, subject=args.subject, log=log)
    finally:
        log.close()
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for pos, r in enumerate(rows, 1):
        print("#%d  candidate %d  %s  (%d finding%s)" % (pos, r["index"], r["verdict"], r["tripped"], "" if r["tripped"] == 1 else "s"))
        for reason in r["reasons"][:3]:
            print("      " + reason[:110])
    print("\n=== best ===\n" + rows[0]["text"])
    return 0


def cmd_recent(args) -> int:
    log = DecisionLog()
    try:
        rows = log.recent(rubric=args.rubric, n=args.n, unlabelled=args.unlabelled)
    finally:
        log.close()
    if not rows:
        print("no decisions match")
        return 0
    import datetime as _dt
    print("%-5s %-15s %-16s %-9s %-6s %s" % ("ID", "TIME", "RUBRIC", "VERDICT", "LABEL", "SUBJECT / STATE"))
    for r in rows:
        ts = _dt.datetime.fromtimestamp(r["ts"]).strftime("%m-%d %H:%M:%S")
        label = r["label"] or "-"
        keys = r.keys()
        hint = r["subject"] or ((r["state_preview"] if "state_preview" in keys and r["state_preview"] else None) or "")[:44].replace("\n", " ") or (r["state_sha256"][:12] + "..")
        print("%-5d %-15s %-16s %-9s %-6s %s" % (r["id"], ts, r["rubric"], r["verdict"], label, hint))
    return 0


def cmd_review(args) -> int:
    log = DecisionLog()
    try:
        r = log.get(args.decision_id)
    finally:
        log.close()
    if not r:
        print("no decision with id %d" % args.decision_id, file=sys.stderr)
        return 3
    print("decision %d  %s  [%s]%s%s" % (
        r["id"], r["rubric"], r["verdict"],
        "  advisory" if r["advisory"] else "",
        "  labelled=" + r["label"] if r["label"] else "  UNLABELLED"))
    print("  subject : %s" % (r["subject"] or "(none)"))
    print("  model   : %s   latency: %sms" % (r["model"] or "-", r["latency_ms"]))
    if r["error"]:
        print("  error   : %s" % r["error"])
    keys = r.keys()
    preview = r["state_preview"] if "state_preview" in keys else None
    if preview:
        print("  state   :\n    " + preview.replace("\n", "\n    "))
    else:
        print("  state   : (preview not stored for pre-migration rows; sha256 %s..)" % r["state_sha256"][:16])
    try:
        answers = json.loads(r["answers_json"] or "{}")
    except ValueError:
        answers = {}
    if answers:
        print("  answers : %s" % json.dumps(answers, sort_keys=True)[:800])
    try:
        reasons = json.loads(r["reasons_json"] or "[]")
    except ValueError:
        reasons = []
    for reason in reasons:
        print("  reason  : %s" % reason)
    print("  label it:  rig-s1gate label %d good|bad" % r["id"])
    return 0


def cmd_selftest(args) -> int:
    """Prove the rule engine and the fail-closed path without calling the API."""
    from rig_capabilities.s1gate import eval_condition

    checks = [
        (({"a": {"type": "noul", "noul": 0.92}}, "a.noul >= 0.60"), True),
        (({"a": {"type": "noul", "noul": 0.10}}, "a.noul >= 0.60"), False),
        (({"a": {"type": "score", "score": 1.39, "confidence": 0.0}}, "a.score >= 2.50"), False),
        (({"a": {"type": "choice", "choice": "x"}}, "a.choice == x"), True),
        (({}, "missing.noul >= 0.5"), None),
        (({"a": {"type": "noul", "noul": 0.5}}, "garbage"), None),
    ]
    bad = 0
    for (answers, expr), want in checks:
        got, note = eval_condition(answers, expr)
        ok = got is want if want is None or got is None else got == want
        if not ok:
            bad += 1
            print("FAIL %-28s want=%s got=%s (%s)" % (expr, want, got, note))
    n = len(list_rubrics())
    print("rule engine: %d/%d checks passed" % (len(checks) - bad, len(checks)))
    print("rubrics loadable: %d" % n)
    for name in list_rubrics():
        load_rubric(name)
    return 1 if bad else 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="rig-s1gate", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list").set_defaults(fn=cmd_list)
    s = sub.add_parser("show"); s.add_argument("rubric"); s.set_defaults(fn=cmd_show)

    c = sub.add_parser("check")
    c.add_argument("rubric")
    c.add_argument("--file", nargs="?", default=None)
    c.add_argument("--text", default=None)
    c.add_argument("--stdin", action="store_true")
    c.add_argument("--subject", default=None)
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_check)

    l = sub.add_parser("label")
    l.add_argument("decision_id", type=int); l.add_argument("label")
    l.add_argument("--signal", help="question.attr for multi-question rubric calibration")
    l.set_defaults(fn=cmd_label)

    cal = sub.add_parser("calibrate")
    cal.add_argument("rubric")
    cal.add_argument("--signal", required=True)
    cal.add_argument("--direction", default="above", choices=["above", "below"])
    cal.add_argument("--max-false-block", type=float, default=0.05)
    cal.add_argument("--min-recall", type=float, default=0.50)
    cal.add_argument("--write", action="store_true")
    cal.set_defaults(fn=cmd_calibrate)

    st = sub.add_parser("stats"); st.add_argument("rubric", nargs="?"); st.set_defaults(fn=cmd_stats)
    cs = sub.add_parser("cache-stats")
    cs.add_argument("rubric", nargs="?")
    cs.add_argument("--json", action="store_true")
    cs.set_defaults(fn=cmd_cache_stats)
    cc = sub.add_parser("cache-clear")
    cc.add_argument("rubric", nargs="?")
    cc.add_argument("--all", action="store_true")
    cc.set_defaults(fn=cmd_cache_clear)
    rc = sub.add_parser("recent")
    rc.add_argument("rubric", nargs="?")
    rc.add_argument("-n", type=int, default=20)
    rc.add_argument("--unlabelled", action="store_true")
    rc.set_defaults(fn=cmd_recent)
    rv = sub.add_parser("review"); rv.add_argument("decision_id", type=int); rv.set_defaults(fn=cmd_review)

    im = sub.add_parser("improve")
    im.add_argument("rubric")
    im.add_argument("--file", default=None); im.add_argument("--text", default=None)
    im.add_argument("--stdin", action="store_true")
    im.add_argument("--context", default=""); im.add_argument("--subject", default=None)
    im.add_argument("--max", type=int, default=3)
    im.add_argument("--accept", default="PASS", choices=["PASS", "ESCALATE"])
    im.add_argument("--json", action="store_true")
    im.set_defaults(fn=cmd_improve)

    rk = sub.add_parser("rank")
    rk.add_argument("rubric"); rk.add_argument("--file", required=True)
    rk.add_argument("--subject", default=None); rk.add_argument("--json", action="store_true")
    rk.set_defaults(fn=cmd_rank)
    sub.add_parser("selftest").set_defaults(fn=cmd_selftest)

    args = p.parse_args(argv)
    try:
        return args.fn(args)
    except S1GateError as exc:
        print("s1gate: %s" % exc, file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
