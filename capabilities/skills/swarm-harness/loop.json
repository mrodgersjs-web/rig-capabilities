{
  "closing_loop": {
    "from": [
      "P"
    ],
    "max_iterations": 3,
    "on_exhaust": "park",
    "to": "I1"
  },
  "coordinate": {
    "bms_mode": "A1",
    "diamond": "D2",
    "level": 3,
    "step": "I1"
  },
  "doctrine_source": [
    "capabilities/loops/swarm-harness.md"
  ],
  "family": "governance",
  "id": "swarm-harness",
  "kill_switch": {
    "max_iterations": 3,
    "max_stop_blocks": 2,
    "max_wall_minutes": 240
  },
  "modes": {
    "auto": {},
    "walk": {
      "stop_after_stage": true
    }
  },
  "name": "Swarm harness (GL-SW/GL-AD)",
  "outward_policy": {
    "require_gate_d": true
  },
  "packet": "LoopRunPacket",
  "schema": "rig.loop-skill.v11",
  "stages": [
    {
      "artifact": "intent.md",
      "gate": [
        {
          "path": "intent.md",
          "patterns": [
            "^## GOAL",
            "^## SWARM-TYPE",
            "^## AGENTS",
            "^## FILE-OWNERSHIP",
            "^## DONE-TEST"
          ],
          "type": "file_contains"
        },
        {
          "hint": "name the swarm type: GL-SW research swarm or GL-AD adversarial/deviation swarm",
          "path": "intent.md",
          "pattern": "(?im)^##\\s*SWARM-TYPE\\s*\\n+\\s*(GL-SW|GL-AD)\\b",
          "type": "regex"
        },
        {
          "hint": "the swarm's done-test must be executable, not an adjective",
          "path": "intent.md",
          "pattern": "(?im)^##\\s*DONE-TEST\\s*\\n\\s*[-*]\\s*(cmd|file|grep|mcp):\\S",
          "type": "regex"
        }
      ],
      "id": "I1",
      "name": "Identity-lock",
      "write_policy": {
        "deny_message": "No agent is spawned before the swarm is locked. Write intent.md: ## GOAL (one sentence all agents get) ## SWARM-TYPE (GL-SW or GL-AD) ## AGENTS (N; 3-10 GL-SW, 2-5 GL-AD) ## FILE-OWNERSHIP (one writer per path) ## DONE-TEST (executable).",
        "mode": "artifacts_only"
      }
    },
    {
      "artifact": "spawn.md",
      "gate": [
        {
          "path": "spawn.md",
          "patterns": [
            "^## Agents",
            "^## Ownership"
          ],
          "type": "file_contains"
        },
        {
          "hint": "every worker row needs an agent id, an explicitly pinned model, and the paths it alone writes (2026-09-29: a laws file was wiped by a parallel write)",
          "min": 3,
          "path": "spawn.md",
          "pattern": "^\\s*-\\s*agent:\\s*\\S+\\s+model:\\s*\\S+\\s+writes:\\s*\\S+",
          "type": "regex_count"
        },
        {
          "hint": "no Flash worker models (Mike's standing rule)",
          "path": "spawn.md",
          "pattern": "(?i)model:\\s*\\S*flash",
          "type": "regex_absent"
        },
        {
          "counter": "spawn_confirmed",
          "min": 3,
          "type": "min_counter"
        }
      ],
      "id": "W",
      "name": "Wire-lease",
      "write_policy": {
        "mode": "open"
      }
    },
    {
      "artifact": "divergence.md",
      "gate": [
        {
          "path": "divergence.md",
          "patterns": [
            "^## Angles",
            "^## Worker-outputs"
          ],
          "type": "file_contains"
        },
        {
          "hint": "one distinct angle per worker; two workers on the same angle is duplicated spend",
          "min": 3,
          "path": "divergence.md",
          "pattern": "^\\s*-\\s*angle:\\s*\\S",
          "type": "regex_count"
        },
        {
          "hint": "workers write to disk incrementally, never only in the final message (2026-09-29: MiMo/Grok workers died after returning an empty message)",
          "min": 3,
          "type": "files_written_min"
        }
      ],
      "id": "D",
      "name": "Diverge",
      "write_policy": {
        "mode": "open"
      }
    },
    {
      "artifact": "convergence.md",
      "gate": [
        {
          "path": "convergence.md",
          "patterns": [
            "^## Conflicts",
            "^## Agreement"
          ],
          "type": "file_contains"
        },
        {
          "hint": "name the disagreement between workers; a swarm that only agrees was not diverging",
          "min": 1,
          "path": "convergence.md",
          "pattern": "^\\s*-\\s*(conflict|agree):\\s*\\S",
          "type": "regex_count"
        }
      ],
      "id": "C",
      "name": "Converge",
      "write_policy": {
        "mode": "open"
      }
    },
    {
      "artifact": "synthesis.md",
      "gate": [
        {
          "path": "synthesis.md",
          "patterns": [
            "^## Claims"
          ],
          "type": "file_contains"
        },
        {
          "hint": "every synthesized claim cites the worker that produced it",
          "min": 3,
          "path": "synthesis.md",
          "pattern": "^\\s*-\\s*\\[w:[A-Za-z0-9._-]+\\]",
          "type": "regex_count"
        },
        {
          "hint": "an empty claims section is a failed swarm, not a clean one",
          "path": "synthesis.md",
          "pattern": "(?im)^##\\s*Claims\\s*\\n\\s*(none|n/?a)\\s*$",
          "type": "regex_absent"
        }
      ],
      "id": "Y",
      "name": "Synthesize",
      "write_policy": {
        "mode": "open"
      }
    },
    {
      "artifact": "verify.md",
      "gate": [
        {
          "path": "verify.md",
          "patterns": [
            "^## Writer-family",
            "^## Verifier-family",
            "^## Verdicts"
          ],
          "type": "file_contains"
        },
        {
          "hint": "a different model family judges the workers' output; a same-family approve is self-scoring",
          "min": 1,
          "type": "independent_verdict"
        },
        {
          "hint": "prove the verifier can go RED by feeding it one known-bad item",
          "min": 1,
          "type": "planted_failure"
        },
        {
          "counter": "unsupported_withdrawn",
          "min": 0,
          "type": "min_counter"
        }
      ],
      "id": "V",
      "name": "Verify",
      "write_policy": {
        "mode": "open"
      }
    },
    {
      "artifact": "proof.json",
      "gate": [
        {
          "type": "sealed"
        }
      ],
      "id": "P",
      "name": "Proof"
    }
  ],
  "version": "11.1.0"
}
