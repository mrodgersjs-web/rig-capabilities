  "created_by": "Jake PAI, from the existing s1gate fixtures (human-decided green/red)",
  "rules": {
    "regression_case_rule": "Every production mistake someone catches becomes a permanent gold case with the corrected label. Never delete it. Over time it turns your worst days into your best tests.",
    "no_deletion": "Cases are superseded with a reason and status=superseded. Never removed.",
    "no_model_answers": "A model-written key rewards whichever judge agrees with that model. Gold labels are decided by a person, blind to the model's verdict.",
    "double_label": "Two independent labels per case where affordable. Their disagreement rate is the most honest number in the pipeline: if two careful humans agree only 80% of the time, no judge will reliably beat 80%.",
    "holdout": "Keep a sealed ~20% slice nobody looks at while iterating. Open it only to confirm a change.",
    "question_version": "A label answers a specific question wording. Reword the question and the label may no longer apply -- bump question_version and re-adjudicate."
  },
  "provenance_note": "Cases promoted from fixtures/ on 2026-10-01 carry decided_by='fixture author' and adjudicated=false. They are real human decisions, but they were never double-labelled and never adjudicated. Treat their agreement rate as a floor, not a measurement.",
