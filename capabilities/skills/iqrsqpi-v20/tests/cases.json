      {"stage": {"id": "B", "status": "pass"}, "expect": {"ok": true}},
      {"hook": {"event": "pre-tool", "tool_name": "Write", "tool_input": {"file_path": "<cwd>/src/b.py"}}, "expect": {"action": "allow"}}
