          "path": "execute.md",
          "patterns": [
            "^## Command",
            "^## Output",
            "^## Verified-as-seen"
          ],
          "type": "file_contains"
        },
        {
          "hint": "how the result was verified the way Mike would see it (browser screenshot, provider UI, remote == HEAD)",
          "path": "execute.md",
          "pattern": "^## Verified-as-seen[^\\n]*\\n(?:[^\\n]*\\n)*?\\s*[-*]\\s+\\S",
