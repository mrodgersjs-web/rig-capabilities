#!/usr/bin/env python3
"""rig-capabilities CLI — manage the canonical capability store.

Commands:
  stats                                   counts by kind/source + install ledger
  reindex                                 rescan repo + all external roots
  agent-pack <agent> [--boot] [--intent T]   resolve an agent pack / boot pack / match agent-shaped queries
  search <query> [--kind K] [--limit N]   search every harness root
  list [--kind K] [--source S] [--limit N]
  get <id>                                print metadata + content head
  add <id> --kind K --path P [--overwrite]   canonicalize an asset into the repo
  install <id> --harness H [--force]      copy canonical asset into a harness root
  live [<id>] [--no-services]             runtime wiring: hooks registered,
                                          skills installed, CLIs on PATH,
                                          service ports bound + identity-matched
  tree [--out PATH]                       rebuild tree/<outcome>/<kind>/<id>
  route <query> [--per N]                 intent -> outcome lanes + top assets
  outcomes                                counts per outcome lane
  fabric-build                            build graph + concepts + embeddings cache
  pack "<intent>" [--budget N] [--max-nodes N] [--min-trust F] [--acl a,b]
                                          [--requester NAME]
  graph <id> [--depth N]                  adjacency expansion
  concepts <concept>                      concept-index lookup
  okf-check                               OKF metadata completeness report
  rate <pack-id> useful|partial|wasted [note]
  registry status [--id ID] [--fetch]     workstation-repo registry health
  refresh [--apply]                       v3 drift report; --apply rebuilds if stale
  trusts                                  v3/v4 decay + ratings trust table
  analytics                               v5 per-asset pack/rating analytics
  publish                                 v5 write .public-catalog.json
  sign [--generate-key] [pack-id]         v5 HMAC-sign a pack (or generate key)
  verify <pack-id>                        v5 verify pack signature
  serve [--port N] [--bind HOST]          HTTP federation surface
  connectors                              SQL/API connector status
  observe                                 Langfuse/local trace status
  corpus scan|classify|truncation         card-corpus scan, classification, truncation seam
  register validate|diff|flags            capability register: row errors, diff, flagged owners
  converge [--week W] [--root DIR]        C_t + A_t; --week scores one week through the gate
  realign [--week W] [--apply]            weekly Realign driver; dry unless --apply
  expert-os phases|advance [--phase N]    Known Expert OS: 1-10 gated, 11 truncated, 12 absent
  evidence validate|resume                Evidence Ledger rule 3; --ledger PATH checks a fixture
  lease <sub> [args]                      worktree leases; passthrough, exit 2 = denial
  canary mint|current|rotate --task T     planted failing canary, rotated per dispatch
  dispatch-verify PACKET [--verify]       admission: 0 PASS, 2 FABRICATED, 3 prefilter-clears (never verified)
  estage score|compare|verdict            E_stage loss, golden-set compare, promotion verdict
  model-route [plan|verify|audit-*]       Fable 5.1 route: plan by default, --apply needs Gate-D
  wire-mcp [plan|verify] [--apply]        harness MCP wiring: plan default, --apply needs Gate-D
  fabrication [--since-days N]            fabrication ledger rates + the verdict ladder
  certify [--only GATE]                   run every gate against this repo, write a report
  self-test [--only GATE]                 green -> plant -> RED -> restore, one gate at a time
"""
from __future__ import annotations

import argparse
import json
import signal
import subprocess
import sys
from pathlib import Path

if hasattr(signal, "SIGPIPE"):
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from rig_capabilities.catalog import KINDS, Repo  # noqa: E402


def _scan_failure(exc: BaseException) -> int:
    """A dying corpus scan reports its own name — never a traceback, never a fake ok.

    The live roots (~/Downloads, ~/mnt/RIGLake) can time out mid-walk, so an operator
    gets the exception name plus the bound-the-scan hint, and the exit code stays red.
    """
    print(json.dumps({"ok": False, "error": f"{type(exc).__name__}: {exc}",
                      "hint": "bound the scan: --root tests/fixtures/fable2031/corpus"},
                     indent=1))
    return 1


def _join_gate_d_tokens(argv: list[str]) -> list[str]:
    """Make the literal `--gate-d APPROVE <run_id>` spelling parse.

    The hints print that exact phrase, but it arrives as three argv tokens and
    the bare run id would land on the subcommand positional, turning an
    instructed command into an argparse usage error. Join the phrase into the
    flag's single value. Only touches spellings that currently die in argparse,
    so no working invocation changes behaviour.
    """
    out: list[str] = []
    i = 0
    while i < len(argv):
        if (argv[i] in ("--gate-d", "--gate-d-run-id")
                and argv[i + 1:i + 2] == ["APPROVE"]
                and argv[i + 2:i + 3] and not argv[i + 2].startswith("-")):
            out.append(argv[i] + "=APPROVE " + argv[i + 2])
            i += 3
            continue
        out.append(argv[i])
        i += 1
    return out


def main() -> int:
    ap = argparse.ArgumentParser(prog="rig-capabilities", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("stats")
    sub.add_parser("reindex")
    p = sub.add_parser("agent-pack")
    p.add_argument("agent", nargs="?")
    p.add_argument("--boot", action="store_true")
    p.add_argument("--intent")

    p = sub.add_parser("gaps")
    p.add_argument("--n", type=int, default=8)
    p.add_argument("--dry", action="store_true")

    p = sub.add_parser("release")
    p.add_argument("--dry", action="store_true")

    p = sub.add_parser("harness-install")
    p.add_argument("--dest")
    p.add_argument("--apply", action="store_true")

    p = sub.add_parser("proofchain")
    p = sub.add_parser("goal-spec")
    p.add_argument("--stem", default="", help="compiled goal stem, e.g. hA-01-code-review")
    p.add_argument("--session-type", default="", help="resolve the goal for a session type")


    p = sub.add_parser("search")
    p.add_argument("query")
    p.add_argument("--kind", choices=KINDS)
    p.add_argument("--limit", type=int, default=20)

    p = sub.add_parser("list")
    p.add_argument("--kind", choices=KINDS)
    p.add_argument("--source")
    p.add_argument("--limit", type=int, default=100)

    p = sub.add_parser("get")
    p.add_argument("id")

    p = sub.add_parser("add")
    p.add_argument("id")
    p.add_argument("--kind", required=True, choices=KINDS)
    p.add_argument("--path", required=True)
    p.add_argument("--overwrite", action="store_true")

    p = sub.add_parser("install")
    p.add_argument("id")
    p.add_argument("--harness", required=True,
                   choices=["claude", "codex", "hermes", "agents", "omp", "prime-agent"])
    p.add_argument("--force", action="store_true")
    p.add_argument("--kind", choices=KINDS)

    p = sub.add_parser("wire")
    p.add_argument("--apply", action="store_true")
    p.add_argument("--verify", action="store_true")

    p = sub.add_parser("live")
    p.add_argument("id", nargs="?")
    p.add_argument("--no-services", action="store_true")

    p = sub.add_parser("tree")
    p.add_argument("--out")

    p = sub.add_parser("route")
    p.add_argument("query")
    p.add_argument("--per", type=int, default=5)

    sub.add_parser("outcomes")
    sub.add_parser("fabric-build")
    sub.add_parser("okf-check")
    sub.add_parser("trusts")
    sub.add_parser("analytics")
    sub.add_parser("publish")

    p = sub.add_parser("pack")
    p.add_argument("intent")
    p.add_argument("--budget", type=int, default=1500)
    p.add_argument("--max-nodes", dest="max_nodes", type=int, default=12)
    p.add_argument("--min-trust", dest="min_trust", type=float, default=0.5)
    p.add_argument("--acl")
    p.add_argument("--requester")
    p.add_argument("--token")

    p = sub.add_parser("graph")
    p.add_argument("id")
    p.add_argument("--depth", type=int, default=1)

    p = sub.add_parser("concepts")
    p.add_argument("concept")
    p.add_argument("--limit", type=int, default=20)

    p = sub.add_parser("concepts-build")
    p.add_argument("--llm", action="store_true")
    p.add_argument("--llm-only", action="store_true")
    p.add_argument("--status", action="store_true")
    p.add_argument("--n", type=int, default=500)

    p = sub.add_parser("rate")
    p.add_argument("pack_id")
    p.add_argument("verdict", choices=["useful", "partial", "wasted"])
    p.add_argument("note", nargs="?", default="")

    sub_reg = sub.add_parser("registry")
    reg_sub = sub_reg.add_subparsers(dest="reg_cmd", required=True)
    p = reg_sub.add_parser("status")
    p.add_argument("--id")
    p.add_argument("--fetch", action="store_true")

    p = sub.add_parser("refresh")
    p.add_argument("--apply", action="store_true")

    p = sub.add_parser("sign")
    p.add_argument("pack_id", nargs="?")
    p.add_argument("--generate-key", action="store_true")

    p = sub.add_parser("verify")
    p.add_argument("pack_id")

    p = sub.add_parser("serve")
    p.add_argument("--port", type=int, default=8765)
    p.add_argument("--bind", default="127.0.0.1")
    p.add_argument("--token")

    p = sub.add_parser("serve-token")
    p.add_argument("--generate", action="store_true")

    p = sub.add_parser("issue-token")
    p.add_argument("agent")
    p.add_argument("--ttl", type=int, default=3600)
    p.add_argument("--mint-key", action="store_true")

    p = sub.add_parser("verify-token")
    p.add_argument("token")

    p = sub.add_parser("quality")
    p.add_argument("--weakest", type=int, default=20)
    p.add_argument("--migrate", action="store_true")

    p = sub.add_parser("reclassify")
    p.add_argument("--apply", action="store_true")

    sub.add_parser("coverage")

    p = sub.add_parser("db-sync")
    p.add_argument("--dsn")

    p = sub.add_parser("test")
    p.add_argument("id")

    p = sub.add_parser("quality-run")
    p.add_argument("--lane")

    p = sub.add_parser("round")
    p.add_argument("lane")
    p.add_argument("--n", type=int, default=5)
    p.add_argument("--dry", action="store_true")
    p.add_argument("--budget", type=int, default=None,
                   help="cap on done-test evaluations this round may spend")
    p.add_argument("--strategy", choices=("informative", "weakest"),
                   default="informative",
                   help="informative = need x Bernoulli variance (default); "
                        "weakest = the original score-ascending order")

    p = sub.add_parser("skillos")
    p.add_argument("skillos_cmd",
                   choices=["dump", "check", "restore", "doors",
                            "witness-write", "witness", "orphan-replay",
                            "provenance"])
    p.add_argument("--count", action="store_true")
    p.add_argument("--strict", action="store_true")
    p.add_argument("--corpus")
    p.add_argument("--deny", default="tesslio/cli")
    p.add_argument("--sha")
    p.add_argument("--dest")
    p.add_argument("--plant-drop")
    p.add_argument("--plant-remove")
    p.add_argument("--plant-leak", action="store_true")
    p.add_argument("--stores", action="store_true")

    sub.add_parser("connectors")
    sub.add_parser("observe")
    # ---- fable-2031 capability system -------------------------------------- #
    p = sub.add_parser("corpus")
    p.add_argument("corpus_cmd", nargs="?", default="scan",
                   choices=["scan", "classify", "truncation"])
    p.add_argument("path", nargs="?", help="card file for classify / truncation")
    p.add_argument("--root", action="append", dest="roots",
                   help="repeatable; bounds the scan (the live roots are slow)")
    p.add_argument("--manifest")

    p = sub.add_parser("register")
    p.add_argument("register_cmd", nargs="?", default="validate",
                   choices=["validate", "diff", "flags"])
    p.add_argument("paths", nargs="*", help="PREV CUR register CSVs for diff")
    p.add_argument("--csv", help="register CSV (default capability_register.csv)")

    p = sub.add_parser("converge")
    p.add_argument("--week", help="ISO week YYYY-Www; omit for plain C_t/A_t metrics")
    p.add_argument("--csv", help="register CSV (default capability_register.csv)")
    p.add_argument("--root", action="append", dest="roots")
    p.add_argument("--bookings", help="bookings JSON (default data/fable2031/bookings-WEEK.json)")
    p.add_argument("--previous", help="previous register CSV")

    p = sub.add_parser("realign")
    p.add_argument("--week", help="ISO week YYYY-Www (default: this week)")
    p.add_argument("--dry", action="store_true",
                   help="explicit no-op — dry is already the default")
    p.add_argument("--apply", action="store_true", help="the only mode that writes")
    p.add_argument("--seal", action="store_true",
                   help="with --apply: hash the artifacts and land a proof_hash "
                        "in the proof chain (writes the live proof root)")
    p.add_argument("--root", action="append", dest="roots",
                   help="repeatable; bounds the corpus scan the week is scored on")

    p = sub.add_parser("expert-os")
    p.add_argument("expert_os_cmd", nargs="?", default="phases",
                   choices=["phases", "advance"])
    p.add_argument("--phase", type=int)
    p.add_argument("--evidence", help="JSON file mapping deliverable slug -> artifact")

    p = sub.add_parser("evidence")
    p.add_argument("evidence_cmd", nargs="?", default="validate",
                   choices=["validate", "resume"])
    p.add_argument("--ledger", help="ledger CSV (default evidence_ledger.csv)")

    p = sub.add_parser("lease")
    p.add_argument("lease_args", nargs=argparse.REMAINDER,
                   help="acquire|release|list|expire|assert — passed through verbatim")

    p = sub.add_parser("canary")
    p.add_argument("canary_cmd", choices=["mint", "current", "rotate"])
    p.add_argument("--task", required=True)

    p = sub.add_parser("dispatch-verify")
    p.add_argument("packet", nargs="?", help="handoff packet JSON")
    p.add_argument("--packet", dest="packet_opt", help="alias of the positional PACKET")
    p.add_argument("--offline", dest="offline", action="store_true",
                   help="explicit no-op — the offline prefilter is already the default")
    p.add_argument("--verify", action="store_true",
                   help="full ladder; needs --checkout, and never emits a fake PASS")
    p.add_argument("--checkout", help="tree materialised at the claimed commit")
    p.add_argument("--verifier-family", default="gpt")
    p.add_argument("--dispatcher-family", default="claude")

    p = sub.add_parser("estage")
    p.add_argument("estage_cmd", choices=["score", "compare", "verdict"])
    p.add_argument("files", nargs="*",
                   help="run/replay JSON: 1 for score, BASE CAND for compare "
                        "(with --manifest first, use --baseline/--candidate instead)")
    p.add_argument("--manifest", help="golden manifest for verdict")
    p.add_argument("--baseline", help="baseline replay doc (also positional)")
    p.add_argument("--candidate", help="candidate replay doc (also positional)")
    p.add_argument("--forced-tool-choice", action="store_true",
                   help="pass the audit verdict: a reachable forced-tool-choice harness blocks promotion")
    p.add_argument("--blocking-gate-regression", action="store_true")

    p = sub.add_parser("model-route")
    p.add_argument("route_cmd", nargs="?", default="plan",
                   choices=["plan", "verify", "audit-fallbacks", "audit-tool-choice"])
    p.add_argument("--apply", action="store_true",
                   help="write the three route targets; needs --gate-d and --max-budget-usd")
    p.add_argument("--gate-d", dest="gate_d",
                   help="APPROVE <run_id> token naming an approved Gate-D run")
    p.add_argument("--max-budget-usd", dest="max_budget", type=float)
    p.add_argument("--root", action="append", dest="roots",
                   help="audit target: litellm root/dir for audit-fallbacks, harness roots otherwise")

    p = sub.add_parser("wire-mcp")
    p.add_argument("wire_cmd", nargs="?", default="plan",
                   choices=["plan", "verify", "selftest"])
    p.add_argument("--apply", action="store_true",
                   help="write the four harness MCP configs; needs --gate-d")
    p.add_argument("--gate-d", dest="gate_d",
                   help="APPROVE <run_id> token naming an approved Gate-D run")
    p.add_argument("--target", action="append", dest="targets",
                   help="restrict the write to this target (repeatable)")

    p = sub.add_parser("fabrication")
    p.add_argument("--since-days", dest="since_days", type=int, default=30)

    p = sub.add_parser("certify")
    p.add_argument("--only", action="append", help="gate name (repeatable)")

    p = sub.add_parser("self-test")
    p.add_argument("--only", action="append", help="gate name (repeatable)")
    # ---- documented script spellings --------------------------------------- #
    # The plan and the canonical assets spell these with `--json` and with long
    # flag names, so every one of those forms has to parse. Output is JSON either
    # way: `--json` is an accepted no-op, not a second format waiting to drift.
    for _name in ("corpus", "register", "converge", "realign", "expert-os", "evidence",
                  "canary", "dispatch-verify", "estage", "model-route", "fabrication",
                  "certify", "self-test", "wire-mcp"):
        sub.choices[_name].add_argument(
            "--json", action="store_true",
            help="output is already JSON; accepted for scripts")
    sub.choices["corpus"].add_argument("--roots", action="append", dest="roots",
                                       help="alias of --root")
    sub.choices["register"].add_argument(
        "--validate", dest="register_cmd", action="store_const", const="validate",
        default=argparse.SUPPRESS, help="alias of the default subcommand")
    sub.choices["converge"].add_argument("--register", dest="csv",
                                        help="alias of --csv")
    sub.choices["realign"].add_argument(
        "--bookings", help="score one week against an explicit bookings JSON (reads only)")
    sub.choices["evidence"].add_argument(
        "--validate", dest="evidence_cmd", action="store_const", const="validate",
        default=argparse.SUPPRESS, help="alias of the default subcommand")
    sub.choices["estage"].add_argument(
        "--studio", help="studio the verdict is for (verdict only; a mismatch is a reason)")
    sub.choices["model-route"].add_argument("--gate-d-run-id", dest="gate_d_run_id",
                                           help="alias of --gate-d")
    sub.choices["wire-mcp"].add_argument("--gate-d-run-id", dest="gate_d_run_id",
                                         help="alias of --gate-d")

    args = ap.parse_args(_join_gate_d_tokens(sys.argv[1:]))

    if args.cmd == "wire":
        cmd = [sys.executable, str(REPO_ROOT / "wire" / "wire.py")]
        if args.apply:
            cmd.append("--apply")
        if args.verify:
            cmd.append("--verify")
        return subprocess.call(cmd)

    repo = Repo(REPO_ROOT)

    if args.cmd == "stats":
        print(json.dumps(repo.stats(), indent=1))
    elif args.cmd == "gaps":
        from rig_capabilities.gaps import write_gap_harnesses
        print(json.dumps(write_gap_harnesses(repo, n=args.n, apply=not args.dry), indent=1))
    elif args.cmd == "release":
        from rig_capabilities.release import build_public_zip
        print(json.dumps(build_public_zip(repo, apply=not args.dry), indent=1))
    elif args.cmd == "harness-install":
        from rig_capabilities.harness_install import harness_install
        print(json.dumps(harness_install(repo, dest=args.dest, apply=args.apply), indent=1))
    elif args.cmd == "proofchain":
        from rig_capabilities.proofchain import verify_roadmap
        print(json.dumps(verify_roadmap(repo), indent=1))
    elif args.cmd == "goal-spec":
        from rig_capabilities.goal_spec import serve as _serve_goal
        _gs = _serve_goal(repo, stem=args.stem,
                          session_type=args.session_type)
        print(json.dumps(_gs, indent=1))
        return 0 if _gs.get("verdict") == "OK" else 1
    elif args.cmd == "agent-pack":
        from rig_capabilities.packs import boot_pack, match_agent, resolve_pack
        if args.intent:
            print(json.dumps(match_agent(repo, args.intent), indent=1))
        elif args.agent:
            bp = boot_pack(repo, args.agent) if args.boot else resolve_pack(repo, args.agent)
            print(json.dumps(bp, indent=1))
        else:
            print("agent-pack: give an agent name or --intent", file=sys.stderr)
            sys.exit(2)
    elif args.cmd == "reindex":
        doc = repo.build_index()
        print(f"indexed {doc['count']} capabilities -> {repo.index_path}")
    elif args.cmd == "live":
        from rig_capabilities.live import live_status
        rep = live_status(repo, id=args.id, services=not args.no_services)
        if args.id:
            s = rep.get("summary", {})
            print(json.dumps({"id": rep["assets"][0]["id"] if rep["assets"] else args.id,
                              **s, "services": rep.get("services")}, indent=1))
        else:
            by = {}
            for r in rep["assets"]:
                by.setdefault(f"{r['kind']}/{r['state']}", []).append(r["id"])
            for k in sorted(by):
                print(f"{k:<16} x{len(by[k])}")
                if k != "skill/wired":
                    for i in by[k][:12]:
                        print(f"    {i}")
                    if len(by[k]) > 12:
                        print(f"    ... +{len(by[k]) - 12} more")
            for s in rep.get("services", []):
                print(f"service/{s['id']:<9} {s['state']:<9} {s.get('owner', '')}")
    elif args.cmd == "search":
        rows = repo.search(args.query, kind=args.kind, limit=args.limit)
        for r in rows:
            desc = r["description"][:90].replace("\n", " ")
            print(f"{r['score']:>4}  {r['kind']:<8} {r['id']:<44} [{r['source']}] {desc}")
        print(f"-- {len(rows)} results")
    elif args.cmd == "list":
        doc = repo.load_index()
        rows = [a for a in doc["assets"]
                if (not args.kind or a["kind"] == args.kind)
                and (not args.source or a["source"] == args.source)]
        for a in rows[:args.limit]:
            print(f"{a['kind']:<8} {a['id']:<44} [{a['source']}]")
        print(f"-- {len(rows)} total, {min(len(rows), args.limit)} shown")
    elif args.cmd == "get":
        matches = repo.resolve(args.id)
        if not matches:
            print(f"unknown capability: {args.id}", file=sys.stderr)
            return 1
        for m in matches:
            print(f"== {m['kind']}/{m['id']} [{m['source']}] sha={m['sha']}")
            print(f"   {m['path']}")
            print(f"   {m['description']}")
    elif args.cmd == "add":
        print(json.dumps(repo.add(args.id, args.kind, args.path,
                                  overwrite=args.overwrite), indent=1))
    elif args.cmd == "install":
        try:
            print(json.dumps(repo.install(args.id, args.harness, force=args.force,
                                          kind=args.kind), indent=1))
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 1
    elif args.cmd == "tree":
        from rig_capabilities.taxonomy import build_tree
        rep = build_tree(repo, Path(args.out) if args.out else None)
        print(json.dumps(rep, indent=1))
    elif args.cmd == "route":
        from rig_capabilities.taxonomy import route
        rep = route(repo, args.query, per=args.per)
        for lane in rep["lanes"]:
            print(f"== {lane['outcome']}  (score {lane['score']})")
            for c in lane["capabilities"]:
                print(f"   {c['kind']:<8} {c['id']:<46} {c['description'][:60]}")
    elif args.cmd == "outcomes":
        from rig_capabilities.taxonomy import dedupe, outcome_counts
        counts = outcome_counts(dedupe(repo.load_index()["assets"]))
        for o, c in counts.items():
            print(f"{o:<20} {c['total']:>5}  {c['kinds']}")
    elif args.cmd == "fabric-build":
        from rig_capabilities.fabric import (build_concepts, build_embeddings,
                                             build_graph)
        print("graph:", build_graph(repo))
        print("concepts:", build_concepts(repo))

        def prog(d, s, f):
            print(f"  embedded {d} (cached {s}, failed {f})", flush=True)

        print("embeddings:", build_embeddings(repo, progress=prog))
    elif args.cmd == "pack":
        from rig_capabilities.fabric import context_pack
        try:
            rep = context_pack(repo, args.intent, budget_tokens=args.budget,
                               max_nodes=args.max_nodes, min_trust=args.min_trust,
                               requester_acl=args.acl.split(",") if args.acl else None,
                               requester=args.requester, token=args.token)
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 1
        print(rep["markdown"])
        print(f"-- tiers={rep['tiers']} lanes={rep['lanes']} "
              f"~{rep['estimated_tokens']}tok artifact={rep['artifact']}",
              file=sys.stderr)
    elif args.cmd == "rate":
        from rig_capabilities.fabric import rate
        print(json.dumps(rate(repo, args.pack_id, args.verdict, args.note)))
    elif args.cmd == "registry" and args.reg_cmd == "status":
        from rig_capabilities.registry import status as reg_status
        print(json.dumps(reg_status(repo_filter=args.id, fetch=args.fetch), indent=1))
    elif args.cmd == "graph":
        from rig_capabilities.fabric import expand
        print(json.dumps(expand(repo, [args.id], depth=args.depth), indent=1))
    elif args.cmd == "concepts":
        from rig_capabilities.fabric import lookup_concept
        res = lookup_concept(repo, args.concept, limit=args.limit)
        rows = res["ids"]
        print("\n".join(f"{i}\t[tier:{('idf' if i in res['tiers']['idf'] else 'llm')}]"
                        for i in rows)
              if rows else "no matches (run fabric-build)")
    elif args.cmd == "concepts-build":
        if args.status:
            from rig_capabilities.concepts_llm import overlay_status
            print(json.dumps(overlay_status(repo, target=args.n), indent=1))
        elif args.llm or args.llm_only:
            from rig_capabilities.concepts_llm import build
            print(json.dumps(build(repo, n=args.n), indent=1))
        if not args.llm_only and not args.status:
            from rig_capabilities.fabric import build_concepts
            print("idf concepts:", build_concepts(repo))
    elif args.cmd == "okf-check":
        from rig_capabilities.okf import check
        print(json.dumps(check(repo), indent=1))
    elif args.cmd == "refresh":
        from rig_capabilities.refresh import auto_refresh, drift_report
        print(json.dumps(auto_refresh(repo) if args.apply else drift_report(repo),
                         indent=1))
    elif args.cmd == "trusts":
        from rig_capabilities.policy import last_observed, ratings_delta
        print(json.dumps({"observed": last_observed(repo),
                          "ratings_delta": ratings_delta(repo)}, indent=1))
    elif args.cmd == "analytics":
        from rig_capabilities.surface import write_analytics
        print(json.dumps(write_analytics(repo), indent=1))
    elif args.cmd == "publish":
        from rig_capabilities.surface import write_public_catalog
        print(json.dumps(write_public_catalog(repo), indent=1))
    elif args.cmd == "sign":
        from rig_capabilities.surface import (generate_key, load_key,
                                              sign_artifact, verify_artifact)
        if args.generate_key:
            p = generate_key(repo)
            print(json.dumps({"key": str(p)}))
            return 0
        if not args.pack_id:
            print("sign: pack-id required (or --generate-key)", file=sys.stderr)
            return 1
        key = load_key(repo)
        if not key:
            print("no signing key (run sign --generate-key)", file=sys.stderr)
            return 1
        p = Path(repo.root) / ".context" / f"{args.pack_id}.json"
        if not p.exists():
            print(f"unknown pack: {args.pack_id}", file=sys.stderr)
            return 1
        art = json.loads(p.read_text())
        art["signature"] = sign_artifact(art, key)
        p.write_text(json.dumps(art, indent=1))
        print(json.dumps({"pack": args.pack_id, "signed": True,
                          "ok": verify_artifact(art, key)}))
    elif args.cmd == "verify":
        from rig_capabilities.surface import load_key, verify_artifact
        key = load_key(repo)
        p = Path(repo.root) / ".context" / f"{args.pack_id}.json"
        if not p.exists():
            print(f"unknown pack: {args.pack_id}", file=sys.stderr)
            return 1
        art = json.loads(p.read_text())
        ok = bool(key) and verify_artifact(art, key)
        print(json.dumps({"pack": args.pack_id, "verified": ok,
                          "has_key": bool(key),
                          "has_signature": bool(art.get("signature"))}))
        return 0 if ok else 1
    elif args.cmd == "serve":
        from rig_capabilities.serve import serve as _serve
        _serve(repo, host=args.bind, port=args.port, token=args.token)
    elif args.cmd == "serve-token":
        from rig_capabilities.serve import generate_serve_token, load_serve_token
        if args.generate:
            p = generate_serve_token(repo)
            print(json.dumps({"token_file": str(p)}))
        else:
            print(json.dumps({"configured": bool(load_serve_token(repo))}))
    elif args.cmd == "issue-token":
        from rig_capabilities.idp import issue_token
        print(json.dumps(issue_token(repo, args.agent, ttl=args.ttl,
                                     mint_key=args.mint_key)))
    elif args.cmd == "verify-token":
        from rig_capabilities.idp import verify_token
        res = verify_token(repo, args.token)
        print(json.dumps(res))
        return 0 if res["ok"] else 1
    elif args.cmd == "connectors":
        from rig_capabilities.connectors import connector_status
        print(json.dumps(connector_status(repo), indent=1))
    elif args.cmd == "observe":
        from rig_capabilities.observe import status as obs_status
        print(json.dumps(obs_status(repo), indent=1))
    elif args.cmd == "quality":
        from rig_capabilities.quality import migrate_canonical, quality_report
        if args.migrate:
            print(json.dumps(migrate_canonical(repo), indent=1))
        rep = quality_report(repo)
        rep["weakest"] = rep["weakest"][:args.weakest]
        print(json.dumps(rep, indent=1))
    elif args.cmd == "reclassify":
        from rig_capabilities.lanes import apply_overlay, classify_overlay
        if args.apply:
            print(json.dumps(apply_overlay(repo), indent=1))
        else:
            ov = classify_overlay(repo)
            from collections import Counter
            print(json.dumps({"would_reassign": len(ov),
                              "by_lane": dict(Counter(ov.values()))}, indent=1))
    elif args.cmd == "coverage":
        import subprocess as _sp
        _sp.call([sys.executable, str(REPO_ROOT / "scripts" / "coverage_matrix.py")])
    elif args.cmd == "test":
        from rig_capabilities.done_tests import run_asset
        res = run_asset(repo, args.id)
        print(json.dumps(res, indent=1))
        return 0 if res["pass"] else 1
    elif args.cmd == "quality-run":
        from rig_capabilities.done_tests import quality_run
        print(json.dumps(quality_run(repo, lane=args.lane), indent=1))
    elif args.cmd == "round":
        from rig_capabilities.rounds import run_round
        rep = run_round(repo, args.lane, n=args.n, dry=args.dry,
                        budget=args.budget, strategy=args.strategy)
        print(json.dumps(rep, indent=1))
        # The round report carries its own verdict (`exit_code`: 1 for a refused
        # replay, a blocked lane, or a red gate). Printing it and exiting 0 would
        # let a caller that checks `$?` — a cron, a CI step, another agent — record
        # a refusal as a success. `python3 -m rig_capabilities.rounds` already does
        # this; the CLI and the MCP tool must not disagree with the module.
        return int(rep.get("exit_code") or 0)
    elif args.cmd == "db-sync":
        from rig_capabilities.sync import sync
        print(json.dumps(sync(repo, dsn=args.dsn), indent=1))
    elif args.cmd == "corpus":
        from rig_capabilities import corpus
        if args.corpus_cmd == "scan":
            try:
                rep = corpus.corpus_report(
                    roots=args.roots, manifest=args.manifest or corpus.SOURCE_MANIFEST)
            except Exception as exc:  # a live-root scan reports, it never tracebacks
                return _scan_failure(exc)
            print(json.dumps(rep, indent=1))
            return 0 if rep.get("ok") else 1
        if not args.path or not Path(args.path).is_file():
            print(json.dumps({"ok": False, "error": f"card_missing:{args.path or ''}"},
                             indent=1))
            return 2
        text = Path(args.path).read_text(encoding="utf-8", errors="replace")
        if args.corpus_cmd == "truncation":
            truncated, anchor = corpus.detect_truncation(text)
            print(json.dumps({"path": args.path, "truncated": truncated,
                              "end_anchor": anchor}, indent=1))
            return 0
        meta, body = corpus.split_frontmatter(text)
        out = corpus.classify({"path": str(Path(args.path).resolve()), "body": body,
                               "title": meta.get("title") or Path(args.path).stem,
                               "tags": meta.get("tags") or []})
        out["card"] = args.path
        print(json.dumps(out, indent=1))
        return 0 if not out.get("unclassified") else 1
    elif args.cmd == "register":
        from rig_capabilities import register as reg
        if args.register_cmd == "diff":
            if len(args.paths) != 2:
                print(json.dumps({"ok": False, "error": "diff_requires_two_csvs"}, indent=1))
                return 2
            out = reg.diff_register(reg.load_register(repo, args.paths[0]),
                                    reg.load_register(repo, args.paths[1]))
            out["previous"], out["current"] = args.paths[0], args.paths[1]
            print(json.dumps(out, indent=1))
            return 0
        rows = reg.load_register(repo, args.csv)
        flagged = reg.flagged_owners(rows)
        if args.register_cmd == "flags":
            print(json.dumps({"rows": len(rows), "flagged_owners": flagged,
                              "ok": not flagged}, indent=1))
            return 0 if not flagged else 1
        errors = reg.row_errors(rows)
        try:
            reg.require_booked_row(rows)
            booked = {"ok": True}
        except reg.RegisterError as exc:
            booked = {"ok": False, "reason": str(exc)}
        ok = not errors and not flagged and booked["ok"]
        print(json.dumps({"rows": len(rows), "row_errors": errors,
                          "flagged_owners": flagged,
                          "booked_qualified_conversation": booked, "ok": ok}, indent=1))
        return 0 if ok else 1
    elif args.cmd == "converge":
        from rig_capabilities import convergence as conv
        from rig_capabilities import register as reg
        if not args.week:
            rows = reg.load_register(repo, args.csv)
            print(json.dumps({"rows": len(rows), **conv.metrics(rows)}, indent=1))
            return 0
        try:
            rep = conv.score_week(repo, roots=args.roots, week=args.week,
                                  bookings_path=args.bookings, previous=args.previous)
        except Exception as exc:
            return _scan_failure(exc)
        print(json.dumps(rep, indent=1))
        return 0 if rep.get("gate", {}).get("verdict") in ("PASS", "BASELINE_ONLY") else 1
    elif args.cmd == "realign":
        from rig_capabilities import realign
        if args.bookings:
            # run_week() has no bookings override, so scoring against an explicit
            # bookings artifact goes through the gate directly. Reads only — with
            # no artifact-writing path here, nothing is claimed as written.
            from rig_capabilities import convergence as conv
            try:
                scored = conv.score_week(repo, roots=args.roots, week=args.week,
                                         bookings_path=args.bookings)
            except Exception as exc:
                return _scan_failure(exc)
            scored["wrote"] = False
            scored["note"] = ("bookings override scored through the weekly gate; "
                              "the artifact-writing path takes no override")
            print(json.dumps(scored, indent=1))
            verdict = scored.get("gate", {}).get("verdict")
            return 0 if verdict in ("PASS", "BASELINE_ONLY") else 1
        try:
            out = realign.run_week(repo, week=args.week, apply=args.apply,
                                   roots=args.roots, seal=args.seal)
        except Exception as exc:
            return _scan_failure(exc)
        print(json.dumps(out, indent=1))
        # BASELINE_ONLY is a complete first measurement, not a failure; FAIL is.
        return 0 if out.get("verdict") in ("PASS", "BASELINE_ONLY") else 1
    elif args.cmd == "expert-os":
        from rig_capabilities import expert_os
        if args.expert_os_cmd == "phases":
            # Flat phase -> status map: 11 is truncated and 12 absent at source,
            # and neither may ever be reported as gated.
            print(json.dumps({str(n): s for n, s in expert_os.PHASE_STATUS.items()},
                             indent=1))
            return 0
        if args.phase is None:
            print(json.dumps({"ok": False, "error": "phase_required"}, indent=1))
            return 2
        deliverables = None
        if args.evidence:
            if not Path(args.evidence).is_file():
                print(json.dumps({"ok": False,
                                  "error": f"evidence_file_missing:{args.evidence}"}, indent=1))
                return 2
            deliverables = json.loads(Path(args.evidence).read_text(encoding="utf-8"))
        try:
            out = expert_os.advance(args.phase, deliverables)
        except ValueError as exc:
            print(json.dumps({"ok": False, "phase": args.phase, "error": str(exc)}, indent=1))
            return 2
        out["phase"] = args.phase
        try:
            out["title"] = expert_os.title(args.phase)
        except ValueError:
            out["title"] = None          # no title is authored for an absent phase
        try:
            out["deliverables"] = list(expert_os.deliverable_slugs(args.phase))
        except ValueError:
            out["deliverables"] = None
        print(json.dumps(out, indent=1))
        return 0 if out.get("ok") else 1
    elif args.cmd == "evidence":
        from rig_capabilities import evidence_ledger as ev
        rows = ev.load_ledger(repo, args.ledger)
        source = args.ledger or ev.LEDGER_PATH
        if not rows:
            print(json.dumps({"ok": False, "ledger": source, "rows": 0,
                              "error": "ledger_empty_or_missing"}, indent=1))
            return 1
        if args.evidence_cmd == "resume":
            claims = ev.resume_claims(rows, root=REPO_ROOT)
            print(json.dumps({"ledger": source, "rows": len(rows),
                              "resume_eligible": len(claims),
                              "ids": [c.get("id") for c in claims]}, indent=1))
            return 0 if claims else 1
        invalid = []
        for row in rows:
            errors = ev.validate_claim(row, root=REPO_ROOT)
            if errors:
                invalid.append({"id": row.get("id") or "?", "errors": errors})
        print(json.dumps({"ledger": source, "rows": len(rows), "invalid": invalid,
                          "ok": not invalid}, indent=1))
        return 0 if not invalid else 1
    elif args.cmd == "lease":
        # Verbatim passthrough: the module owns the denial exit code (2) and the
        # reason JSON (lease_held_by, state_root) — nothing here may swallow either.
        return subprocess.call([sys.executable, "-m", "rig_capabilities.lease",
                                *args.lease_args], cwd=str(REPO_ROOT))
    elif args.cmd == "canary":
        from rig_capabilities import canary
        try:
            if args.canary_cmd == "mint":
                spec = canary.mint(args.task)
            elif args.canary_cmd == "rotate":
                spec = canary.rotate(args.task)
            else:
                spec = canary.current(args.task)
        except Exception as exc:
            print(json.dumps({"ok": False, "task_id": args.task,
                              "error": f"{type(exc).__name__}: {exc}"}, indent=1))
            return 2
        if isinstance(spec, dict):
            print(json.dumps(spec, indent=1, sort_keys=True))
            return 0
        print(json.dumps({"task_id": args.task, "canary": None,
                          "reason": "canary_never_minted"}, indent=1, sort_keys=True))
        return 1
    elif args.cmd == "dispatch-verify":
        from rig_capabilities import dispatcher
        source = args.packet_opt or args.packet
        if not source or not Path(source).is_file():
            print(json.dumps({"ok": False, "error": f"packet_missing:{source or ''}"},
                             indent=1))
            return 2
        if args.verify and args.offline:
            print(json.dumps({"ok": False, "packet": source,
                              "error": "offline_and_verify_conflict"}, indent=1))
            return 2
        try:
            if args.verify and not args.checkout:
                print(json.dumps({"ok": False, "packet": source,
                                  "error": "checkout_required_for_verify",
                                  "hint": ("materialise the claimed tree with "
                                           "dispatcher.verifier_checkout_plan: "
                                           "git -C <repo> archive <sha> | tar -x -C <dir>")},
                                 indent=1))
                return 2
            packet = json.loads(Path(source).read_text(encoding="utf-8"))
            # --verify without a re-executor used to mean BLOCKED forever: the kill
            # shot had never actually run outside a fixture. Now the ladder re-runs
            # the production commands inside the materialised tree.
            out = dispatcher.admit(packet, args.checkout,
                                   family_of_verifier=args.verifier_family,
                                   family_of_dispatcher=args.dispatcher_family,
                                   reexec=(None if not args.checkout
                                           else dispatcher.subprocess_replay),
                                   offline=not args.verify)
        except dispatcher.AdmissionError as exc:
            print(json.dumps({"ok": False, "packet": source, "error": str(exc)}, indent=1))
            return 2
        except json.JSONDecodeError as exc:
            print(json.dumps({"ok": False, "packet": source,
                              "error": f"packet_not_json:{exc}"}, indent=1))
            return 2
        out["mode"] = "offline_prefilter" if args.offline or not args.verify else "full_ladder"
        out["tac_bound"] = dispatcher.normalize_records(packet)
        print(json.dumps(out, indent=1))
        verdict = out.get("verdict")
        if verdict == "PASS":
            return 0
        if verdict in ("FABRICATED", "ISOLATION_BREACH"):
            return 2
        if verdict == "PREFILTER_CLEAR":
            # Exit 3, never 0. `estage` scores a non-zero exit as not-passed, and
            # 0 is reserved for a verdict that re-executed the claimed commands.
            # Anything reading "rc==0 means verified" cannot mis-read this rung.
            return 3
        return 1
    elif args.cmd == "estage":
        from rig_capabilities import estage

        def _doc(path):
            return json.loads(Path(path).read_text(encoding="utf-8"))

        def _scored(spec):
            missions = spec.get("missions") if isinstance(spec, dict) else None
            runs = spec.get("runs") if isinstance(spec, dict) else spec
            out = []
            for raw in runs or []:
                run = dict(raw)
                mid = run.get("mission_id") or run.get("id")
                if "mission" not in run and isinstance(missions, dict) and mid in missions:
                    run["mission"] = missions[mid]   # the doc carries the declared ceilings
                out.append({"mission_id": mid, "e_stage": estage.e_stage(run)})
            return out

        def _fail(reason):
            print(json.dumps({"ok": False, "error": str(reason)}, indent=1))
            return 2

        pair = args.files or [a for a in (args.baseline, args.candidate) if a]
        try:
            if args.estage_cmd == "score":
                if len(args.files) != 1:
                    return _fail("score_takes_one_run_file")
                scored = _scored(_doc(args.files[0]))
                if not scored:
                    return _fail("no_runs_declared")
                print(json.dumps({"file": args.files[0], "runs": scored,
                                  "mean_e_stage": sum(r["e_stage"] for r in scored) / len(scored),
                                  "weights": estage.E_STAGE_WEIGHTS}, indent=1))
                return 0
            if args.estage_cmd == "compare":
                if len(pair) != 2:
                    return _fail("compare_takes_baseline_and_candidate")
                cmp = estage.compare(_doc(pair[0]), _doc(pair[1]))
                print(json.dumps({"baseline": pair[0], "candidate": pair[1], **cmp}, indent=1))
                return 0 if cmp.get("strictly_lower_everywhere") else 1
            if not args.manifest:
                return _fail("manifest_required")
            if len(pair) != 2:
                return _fail("verdict_takes_baseline_and_candidate_replays")
            manifest = estage.load_manifest(args.manifest)
            candidate = _doc(pair[1])
            spend = {"candidate_family": manifest.get("candidate_family"),
                     "verifier_family": manifest.get("verifier_family"),
                     "manifest_signature": estage.manifest_signature(manifest),
                     "replay_signature": candidate.get(estage.SIGNATURE_FIELD),
                     "studio": manifest.get("studio"),
                     "blocking_gate_regression": args.blocking_gate_regression,
                     "forced_tool_choice": args.forced_tool_choice}
            cmp = estage.compare(_doc(pair[0]), candidate)
            verdict = estage.promotion_verdict(args.studio or manifest.get("studio"),
                                               cmp, spend)
            print(json.dumps({
                "verdict_studio": args.studio or manifest.get("studio"),
                "manifest_studio": manifest.get("studio"), "status": manifest.get("status"),
                "promotion_gate": manifest.get("promotion_gate"),
                "candidate_provenance": candidate.get("provenance"),
                "candidate_synthetic": candidate.get("synthetic"),
                "rebaseline_required": estage.rebaseline_required(
                    manifest.get("recorded_under"), manifest.get("candidate_family")),
                "mean_baseline": cmp.get("mean_baseline"),
                "mean_candidate": cmp.get("mean_candidate"),
                **verdict}, indent=1))
            return 0 if verdict.get("promote") else 1
        except estage.GoldenSetInvalid as exc:
            return _fail(exc)
    elif args.cmd == "model-route":
        token = args.gate_d or args.gate_d_run_id
        if args.apply and not token:
            # Dormant-by-default is the load-bearing safety property, so this refusal
            # returns before the route module is even imported: zero writes.
            print(json.dumps({"ok": False, "writes": 0, "action": "route-projection",
                              "reason": "gate_d_required",
                              "hint": "re-run with --gate-d APPROVE <run_id> --max-budget-usd N "
                                      "once ~/.rig/proof/gate-d-<run_id>.json is APPROVED"},
                             indent=1))
            return 2
        from rig_capabilities import model_route
        if args.apply:
            if args.max_budget is None:
                print(json.dumps({"ok": False, "writes": 0, "reason": "max_budget_required"},
                                 indent=1))
                return 2
            try:
                out = model_route.apply(repo, gate_d_run_id=token,
                                        max_budget_usd=args.max_budget)
            except model_route.RouteGateError as exc:
                print(json.dumps({"ok": False, "writes": 0, "reason": str(exc)}, indent=1))
                return 1
            print(json.dumps(out, indent=1))
            return 0 if out.get("ok", True) else 1
        if args.route_cmd == "plan":
            out = model_route.plan(repo)
        elif args.route_cmd == "verify":
            out = model_route.verify(repo)
        elif args.route_cmd == "audit-fallbacks":
            out = model_route.audit_fallback_ladders(args.roots[0] if args.roots else None)
        else:
            out = model_route.audit_forced_tool_choice(
                args.roots or [str(REPO_ROOT / "capabilities")])
        print(json.dumps(out, indent=1))
        return 0 if out.get("ok", True) else 1
    elif args.cmd == "wire-mcp":
        token = (args.gate_d or args.gate_d_run_id or "").strip()
        if token.startswith("APPROVE "):
            # Accept the literal approval phrase as well as the bare run_id.
            token = token[len("APPROVE "):].strip()
        if args.apply and not token:
            # Dormant-by-default is the load-bearing safety property, so this refusal
            # returns before the wire module is even imported: zero writes.
            print(json.dumps({"ok": False, "writes": 0, "action": "mcp-wire",
                              "reason": "gate_d_required",
                              "hint": "re-run with --gate-d <run_id> once ~/.rig/proof/gate-d-<run_id>.json is APPROVED and names these targets"},
                             indent=1))
            return 2
        from rig_capabilities import mcp_wire
        if args.apply:
            try:
                out = mcp_wire.apply(token, targets_only=args.targets or None)
            except mcp_wire.WireGateError as exc:
                print(json.dumps({"ok": False, "writes": 0, "reason": str(exc)}, indent=1))
                return 2
            print(json.dumps(out, indent=1))
            return 0 if out.get("all_wired") else 1
        if args.wire_cmd == "selftest":
            out = mcp_wire.selftest()
            print(json.dumps(out, indent=1))
            return 0 if out.get("all_resolvable") else 1
        out = mcp_wire.verify() if args.wire_cmd == "verify" else mcp_wire.plan()
        print(json.dumps(out, indent=1))
        return 0 if out.get("ok", True) else 1
    elif args.cmd == "fabrication":
        from rig_capabilities import afproof
        rates = afproof.fabrication_rates(since_days=args.since_days)
        print(json.dumps({"rates": rates, "ladder": afproof.verdict_ladder()}, indent=1))
        return 0 if not rates.get("fabricated") else 1
    elif args.cmd == "certify":
        from rig_capabilities.certify import certify as run_certify, run_gates
        if args.only:
            gates = run_gates(repo, only=args.only)
            rep = {"gates": gates, "only": args.only,
                   "verdict": bool(gates) and all(g["ok"] for g in gates.values())}
        else:
            rep = run_certify(repo)
        print(json.dumps(rep, indent=1))
        return 0 if rep.get("verdict") else 1
    elif args.cmd == "self-test":
        from rig_capabilities.certify import self_test
        rep = self_test(repo, only=args.only)
        print(json.dumps(rep, indent=1))
        return 0 if rep.get("verdict") else 1
    elif args.cmd == "skillos":
        from rig_capabilities.skillos import dispatch as skillos_dispatch
        rep = skillos_dispatch(
            repo, args.skillos_cmd,
            count=args.count,
            strict=args.strict,
            plant_drop=args.plant_drop,
            plant_remove=args.plant_remove,
            plant_leak=args.plant_leak,
            sha=args.sha,
            dest=args.dest,
            corpus=args.corpus,
            deny=args.deny,
            stores=args.stores,
        )
        print(json.dumps(rep, indent=1))
        return int(rep.get("exit_code", 0 if rep.get("ok", True) else 1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
