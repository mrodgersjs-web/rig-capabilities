{
  "install_roots": {
    "harness": {
      "claude": "~/.claude/harnesses",
      "codex": "~/.codex/harnesses",
      "hermes": "~/.hermes/jake/goal-harnesses",
      "omp": "~/.omp/harnesses",
      "prime-agent": "~/.prime/agent/harnesses"
    },
    "loop": {
      "claude": "~/.claude/harnesses",
      "codex": "~/.codex/harnesses",
      "hermes": "~/.hermes/jake/goal-harnesses",
      "omp": "~/.omp/harnesses",
      "prime-agent": "~/.prime/agent/harnesses"
    }
  },
  "external_roots": [
    {
      "label": "codex-harnesses",
      "kind": "harness",
      "path": "~/.codex/harnesses",
      "pattern": "*.yaml"
    },
    {
      "label": "codex-loops",
      "kind": "loop",
      "path": "~/.codex/harnesses",
      "pattern": "*.md"
    },
    {
      "label": "omp-harnesses",
      "kind": "harness",
      "path": "~/.omp/harnesses",
      "pattern": "*.yaml"
    },
    {
      "label": "omp-loops",
      "kind": "loop",
      "path": "~/.omp/harnesses",
      "pattern": "*.md"
    },
    {
      "label": "prime-harnesses",
      "kind": "harness",
      "path": "~/.prime/agent/harnesses",
      "pattern": "*.yaml"
    },
    {
      "label": "prime-loops",
      "kind": "loop",
      "path": "~/.prime/agent/harnesses",
      "pattern": "*.md"
    },
    {
      "label": "intel",
      "kind": "skill",
      "path": "~/Developer/rig-capabilities/intel",
      "pattern": "**/*.md"
    }
  ]
}
