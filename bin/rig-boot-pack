#!/usr/bin/env python3
"""V13 — session-start boot pack.

Writes .context/last-boot-pack.json: a small context pack for the current
harness identity + repo, so every session starts with its capabilities
pre-surfaced. Silent, fast, best-effort. HARNESS_NAME env selects the agent.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

PKG = Path(__file__).resolve().parent.parent
REPO = Path(os.environ.get("RIG_CAP_REPO", PKG))
sys.path.insert(0, str(PKG))

def main() -> int:
    try:
        from rig_capabilities.catalog import Repo
        from rig_capabilities.fabric import context_pack
    except Exception:
        return 0
    harness = os.environ.get("HARNESS_NAME", "session")
    repo = Repo(REPO)
    # if an agent pack exists, bias the intent toward its lanes
    intent = f"session start for {harness}"
    pack_json = REPO / "agents" / harness / "pack.json"
    if pack_json.exists():
        try:
            lanes = json.loads(pack_json.read_text()).get("lanes") or []
            if lanes:
                intent = f"session start for {harness}: {', '.join(lanes)}"
        except Exception:
            pass
    try:
        rep = context_pack(repo, intent, budget_tokens=800, max_nodes=6,
                           requester=harness, sign=False)
    except Exception:
        return 0
    out = {"harness": harness, "intent": intent,
           "nodes": [n["id"] for n in rep.get("nodes", [])],
           "lanes": rep.get("lanes"), "artifact": rep.get("artifact")}
    dst = REPO / ".context" / "last-boot-pack.json"
    dst.parent.mkdir(exist_ok=True)
    dst.write_text(json.dumps(out, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
